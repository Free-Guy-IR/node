+package router_test
+
+import (
+	"context"
+	"fmt"
+	"github.com/xtls/xray-core/common/geodata"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+func TestAddingALargeDomainRuleDoesNotStallRoutePicking(t *testing.T) {
+	const domains = 400000
+	r := new(Router)
+	common.Must(r.Init(context.Background(), &Config{
+		Rule: []*RoutingRule{{RuleTag: "plain", TargetTag: &RoutingRule_Tag{Tag: "direct"}, Networks: []net.Network{net.Network_TCP}}},
+	}, nil, &mockOutboundManager{}, nil))
+	defer r.Close()
+
+	large := make([]*geodata.DomainRule, 0, domains)
+	for i := range domains {
+		large = append(large, &geodata.DomainRule{Value: &geodata.DomainRule_Custom{Custom: &geodata.Domain{Type: geodata.Domain_Domain, Value: fmt.Sprintf("blocked-%d.example", i)}}})
+	}
+	config := serial.ToTypedMessage(&Config{Rule: []*RoutingRule{{RuleTag: "large", TargetTag: &RoutingRule_Tag{Tag: "blocked"}, Domain: large}}})
+
+	ctx := routing_session.AsRoutingContext(session.ContextWithOutbounds(context.Background(), []*session.Outbound{{
+		Target: net.TCPDestination(net.DomainAddress("example.com"), 443),
+	}}))
+	var worst atomic.Int64
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			start := time.Now()
+			if _, err := r.PickRoute(ctx); err != nil {
+				t.Error(err)
+				return
+			}
+			if took := int64(time.Since(start)); took > worst.Load() {
+				worst.Store(took)
+			}
+		}
+	}()
+
+	time.Sleep(50 * time.Millisecond)
+	addStart := time.Now()
+	if err := r.AddRule(config, true); err != nil {
+		t.Fatal(err)
+	}
+	addTook := time.Since(addStart)
+	time.Sleep(50 * time.Millisecond)
+	close(stop)
+	<-done
+
+	t.Logf("AddRule of %d domains took %s; the slowest concurrent PickRoute took %s", domains, addTook.Round(time.Millisecond), time.Duration(worst.Load()).Round(time.Millisecond))
+	if time.Duration(worst.Load()) > 200*time.Millisecond {
+		t.Fatalf("a route pick for an unrelated destination waited %s while a %d-domain rule was being built", time.Duration(worst.Load()).Round(time.Millisecond), domains)
+	}
+}
