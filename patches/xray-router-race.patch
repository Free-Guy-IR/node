+package router_test
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+func TestRemovingAWebhookRuleDoesNotStallRoutePicking(t *testing.T) {
+	const hold = 2 * time.Second
+	received := make(chan struct{}, 16)
+	release := make(chan struct{})
+	slow := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		received <- struct{}{}
+		select {
+		case <-release:
+		case <-time.After(hold):
+		}
+	}))
+	defer slow.Close()
+	defer close(release)
+
+	r := new(Router)
+	common.Must(r.Init(context.Background(), &Config{
+		Rule: []*RoutingRule{
+			{RuleTag: "hooked", TargetTag: &RoutingRule_Tag{Tag: "hooked"}, Networks: []net.Network{net.Network_UDP}, Webhook: &WebhookConfig{Url: slow.URL}},
+			{RuleTag: "plain", TargetTag: &RoutingRule_Tag{Tag: "direct"}, Networks: []net.Network{net.Network_TCP}},
+		},
+	}, nil, &mockOutboundManager{}, nil))
+	defer r.Close()
+
+	routeFor := func(dest net.Destination) (string, error) {
+		ctx := routing_session.AsRoutingContext(session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: dest}}))
+		route, err := r.PickRoute(ctx)
+		if err != nil {
+			return "", err
+		}
+		return route.GetOutboundTag(), nil
+	}
+
+	if tag, err := routeFor(net.UDPDestination(net.DomainAddress("example.com"), 53)); err != nil || tag != "hooked" {
+		t.Fatalf("webhook rule picked %q, %v", tag, err)
+	}
+	select {
+	case <-received:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the webhook POST never reached the endpoint")
+	}
+
+	removed := make(chan error, 1)
+	go func() { removed <- r.RemoveRule("hooked") }()
+	time.Sleep(100 * time.Millisecond)
+
+	start := time.Now()
+	tag, err := routeFor(net.TCPDestination(net.DomainAddress("example.com"), 443))
+	took := time.Since(start)
+	if err != nil || tag != "direct" {
+		t.Fatalf("unrelated route picked %q, %v", tag, err)
+	}
+	if took > 500*time.Millisecond {
+		t.Fatalf("picking an unrelated route took %s while RemoveRule waited for a slow webhook POST", took.Round(time.Millisecond))
+	}
+	if err := <-removed; err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/app/router/router_writers_race_test.go b/app/router/router_writers_race_test.go
new file mode 100644
index 0000000..95b16a1
--- /dev/null
+++ b/app/router/router_writers_race_test.go
@@ -0,0 +1,153 @@
+package router_test
+
+import (
+	"context"
+	"fmt"
+	"github.com/xtls/xray-core/common/geodata"
+	"sync"
+	"testing"
+
+	. "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+func pickTagFor(r *Router, domain string) (string, error) {
+	ctx := routing_session.AsRoutingContext(session.ContextWithOutbounds(context.Background(), []*session.Outbound{{
+		Target: net.TCPDestination(net.DomainAddress(domain), 443),
+	}}))
+	route, err := r.PickRoute(ctx)
+	if err != nil {
+		return "", err
+	}
+	return route.GetOutboundTag(), nil
+}
+
+func domainRule(tag string) *serial.TypedMessage {
+	return serial.ToTypedMessage(&Config{
+		Rule: []*RoutingRule{{
+			RuleTag:   tag,
+			TargetTag: &RoutingRule_Tag{Tag: tag},
+			Domain:    []*geodata.DomainRule{{Value: &geodata.DomainRule_Custom{Custom: &geodata.Domain{Type: geodata.Domain_Full, Value: tag + ".example"}}}},
+		}},
+		BalancingRule: []*BalancingRule{{Tag: "balancer-" + tag, OutboundSelector: []string{tag}}},
+	})
+}
+
+func TestConcurrentRuleWritersLoseNoUpdateWhileRoutesArePicked(t *testing.T) {
+	r := new(Router)
+	common.Must(r.Init(context.Background(), &Config{}, nil, &mockOutboundManager{}, nil))
+	defer r.Close()
+
+	stop := make(chan struct{})
+	var readers sync.WaitGroup
+	for range 4 {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				if tag, err := pickTagFor(r, "unmatched.example"); err != common.ErrNoClue {
+					t.Errorf("an unmatched destination picked %q, %v", tag, err)
+					return
+				}
+				_ = r.ListRule()
+				_, _ = r.GetOverrideTarget("balancer-w0-0")
+			}
+		}()
+	}
+
+	const writers = 8
+	const perWriter = 60
+	var writing sync.WaitGroup
+	for w := range writers {
+		writing.Add(1)
+		go func() {
+			defer writing.Done()
+			for i := range perWriter {
+				tag := fmt.Sprintf("w%d-%d", w, i)
+				if err := r.AddRule(domainRule(tag), true); err != nil {
+					t.Errorf("AddRule(%s): %v", tag, err)
+					return
+				}
+				if got, err := pickTagFor(r, tag+".example"); err != nil || got != tag {
+					t.Errorf("after AddRule(%s) returned, its destination picked %q, %v", tag, got, err)
+					return
+				}
+				if i%2 == 0 {
+					continue
+				}
+				if err := r.RemoveRule(tag); err != nil {
+					t.Errorf("RemoveRule(%s): %v", tag, err)
+					return
+				}
+				if got, err := pickTagFor(r, tag+".example"); err != common.ErrNoClue {
+					t.Errorf("after RemoveRule(%s) returned, its destination still picked %q, %v", tag, got, err)
+					return
+				}
+			}
+		}()
+	}
+
+	contested := make(chan error, writers)
+	for range writers {
+		writing.Add(1)
+		go func() {
+			defer writing.Done()
+			contested <- r.AddRule(serial.ToTypedMessage(&Config{
+				Rule: []*RoutingRule{{RuleTag: "contested", TargetTag: &RoutingRule_Tag{Tag: "contested"}, Domain: []*geodata.DomainRule{{Value: &geodata.DomainRule_Custom{Custom: &geodata.Domain{Type: geodata.Domain_Full, Value: "contested.example"}}}}}},
+			}), true)
+		}()
+	}
+
+	writing.Wait()
+	close(stop)
+	readers.Wait()
+	close(contested)
+
+	accepted := 0
+	for err := range contested {
+		if err == nil {
+			accepted++
+		}
+	}
+	if accepted != 1 {
+		t.Errorf("%d concurrent AddRule calls with the same ruleTag succeeded, want exactly 1", accepted)
+	}
+
+	want := map[string]bool{"contested": true}
+	for w := range writers {
+		for i := 0; i < perWriter; i += 2 {
+			want[fmt.Sprintf("w%d-%d", w, i)] = true
+		}
+	}
+	got := map[string]int{}
+	for _, route := range r.ListRule() {
+		got[route.GetRuleTag()]++
+	}
+	for tag := range want {
+		if got[tag] != 1 {
+			t.Errorf("rule %s is listed %d times, want once", tag, got[tag])
+		}
+	}
+	for tag, count := range got {
+		if !want[tag] {
+			t.Errorf("rule %s is listed %d times after it was removed", tag, count)
+		}
+	}
+	for w := range writers {
+		for i := range perWriter {
+			tag := fmt.Sprintf("w%d-%d", w, i)
+			if _, err := r.GetOverrideTarget("balancer-" + tag); err != nil {
+				t.Errorf("balancer of %s was lost: %v", tag, err)
+			}
+		}
+	}
+}
