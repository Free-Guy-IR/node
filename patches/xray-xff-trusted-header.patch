diff --git a/common/protocol/http/trusted_forwarder.go b/common/protocol/http/trusted_forwarder.go
new file mode 100644
index 0000000..c82b5a8
--- /dev/null
+++ b/common/protocol/http/trusted_forwarder.go
@@ -0,0 +1,103 @@
+package http
+
+import (
+	"context"
+	gonet "net"
+	"net/netip"
+	"strings"
+	"sync"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/platform"
+)
+
+const trustedForwarderCIDRsEnv = "xray.trusted.forwarder.cidrs"
+
+var trustedForwarders = sync.OnceValue(func() []netip.Prefix {
+	return parseTrustedForwarderCIDRs(platform.NewEnvFlag(trustedForwarderCIDRsEnv).GetValue(func() string { return "" }))
+})
+
+func parseTrustedForwarderCIDRs(value string) []netip.Prefix {
+	var prefixes []netip.Prefix
+	for _, field := range strings.Split(value, ",") {
+		field = strings.TrimSpace(field)
+		if field == "" {
+			continue
+		}
+		prefix, err := netip.ParsePrefix(field)
+		if err != nil {
+			errors.LogError(context.Background(), `XRAY_TRUSTED_FORWARDER_CIDRS is not a valid CIDR list, so no trusted header will be honoured: `, err)
+			return nil
+		}
+		prefixes = append(prefixes, prefix.Masked())
+	}
+	return prefixes
+}
+
+func peerIsTrustedForwarder(remoteAddr net.Addr) bool {
+	ip, ok := peerIP(remoteAddr)
+	if !ok {
+		return false
+	}
+	for _, prefix := range trustedForwarders() {
+		if prefix.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+func peerIP(remoteAddr net.Addr) (netip.Addr, bool) {
+	var ip net.IP
+	switch addr := remoteAddr.(type) {
+	case *net.TCPAddr:
+		ip = addr.IP
+	case *net.UDPAddr:
+		ip = addr.IP
+	case nil:
+		return netip.Addr{}, false
+	default:
+		host, _, err := gonet.SplitHostPort(addr.String())
+		if err != nil {
+			return netip.Addr{}, false
+		}
+		ip = gonet.ParseIP(host)
+	}
+	parsed, ok := netip.AddrFromSlice(ip)
+	if !ok {
+		return netip.Addr{}, false
+	}
+	return parsed.Unmap(), true
+}
+
+func TrustedClientAddress(values func(string) []string, trusted []string, remoteAddr net.Addr) net.Addr {
+	for _, key := range trusted {
+		found := values(key)
+		if len(found) == 0 {
+			continue
+		}
+		if !peerIsTrustedForwarder(remoteAddr) {
+			errors.LogWarning(context.Background(), `ignored trusted header "`, key, `" from `, remoteAddr, ` because the peer is not inside XRAY_TRUSTED_FORWARDER_CIDRS`)
+			return remoteAddr
+		}
+		if len(found) == 1 {
+			if addr := net.ParseAddress(strings.TrimSpace(found[0])); addr.Family().IsIP() {
+				return &net.TCPAddr{
+					IP:   addr.IP(),
+					Port: 0,
+				}
+			}
+		}
+		errors.LogWarning(context.Background(), `ignored trusted header "`, key, `" from `, remoteAddr, ` because its value is not a single IP address`)
+		return remoteAddr
+	}
+	if forwardedFor := values("X-Forwarded-For"); len(forwardedFor) > 0 {
+		if len(trusted) == 0 {
+			errors.LogWarning(context.Background(), `received "X-Forwarded-For" from `, remoteAddr, ` but "sockopt.trustedXForwardedFor" is not configured; ignoring it and using the real remote address`)
+		} else {
+			errors.LogError(context.Background(), `ignored potentially forged "X-Forwarded-For" from `, remoteAddr, `: `, forwardedFor[0])
+		}
+	}
+	return remoteAddr
+}
