diff --git a/testing/trustedheader/trustedheader.go b/testing/trustedheader/trustedheader.go
new file mode 100644
index 0000000..e57a0b1
--- /dev/null
+++ b/testing/trustedheader/trustedheader.go
@@ -0,0 +1,178 @@
+package trustedheader
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+const (
+	cidrsEnv    = "XRAY_TRUSTED_FORWARDER_CIDRS"
+	scenarioEnv = "XRAY_TRUSTED_HEADER_TEST_SCENARIO"
+)
+
+type Scenario struct {
+	Name    string
+	CIDRs   *string
+	IPv6    bool
+	Trusted []string
+	Header  map[string]string
+	Want    string
+}
+
+func (s Scenario) PeerHost() string {
+	if s.IPv6 {
+		return "::1"
+	}
+	return "127.0.0.1"
+}
+
+func cidrs(value string) *string {
+	return &value
+}
+
+var cfConnectingIP = []string{"CF-Connecting-IP"}
+
+var Scenarios = []Scenario{
+	{
+		Name:    "forged first X-Forwarded-For entry never becomes the source",
+		CIDRs:   cidrs("127.0.0.1/32"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1, fd00::2", "CF-Connecting-IP": "fd00::7"},
+		Want:    "[fd00::7]:0",
+	},
+	{
+		Name:    "env unset trusts no header",
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:    "env empty trusts no header",
+		CIDRs:   cidrs(""),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:    "env with only separators trusts no header",
+		CIDRs:   cidrs(" , ,"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:    "peer inside the CIDRs gets the header value",
+		CIDRs:   cidrs("127.0.0.1/32"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+		Want:    "[fd00::7]:0",
+	},
+	{
+		Name:    "IPv4 header value is accepted",
+		CIDRs:   cidrs("127.0.0.1/32"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "127.0.0.1"},
+		Want:    "127.0.0.1:0",
+	},
+	{
+		Name:    "peer outside the CIDRs gets the peer",
+		CIDRs:   cidrs("fd00::/8"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:    "IPv6 peer inside ::1/128 gets the header value",
+		CIDRs:   cidrs("::1/128"),
+		IPv6:    true,
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+		Want:    "[fd00::7]:0",
+	},
+	{
+		Name:    "IPv6 peer outside fd00::/8 gets the peer",
+		CIDRs:   cidrs("fd00::/8"),
+		IPv6:    true,
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:    "whitespace and empty entries are tolerated",
+		CIDRs:   cidrs(" 127.0.0.1/32 , ::1/128 ,, "),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+		Want:    "[fd00::7]:0",
+	},
+	{
+		Name:    "invalid CIDR entry fails closed",
+		CIDRs:   cidrs("127.0.0.1/32, not-a-cidr"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:    "invalid header value falls back to the peer",
+		CIDRs:   cidrs("127.0.0.1/32"),
+		Trusted: cfConnectingIP,
+		Header:  map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "not-an-ip"},
+	},
+	{
+		Name:   "no trusted list gives the peer inside the CIDRs",
+		CIDRs:  cidrs("127.0.0.1/32"),
+		Header: map[string]string{"X-Forwarded-For": "fd00::1", "CF-Connecting-IP": "fd00::7"},
+	},
+	{
+		Name:   "forged x-real-ip without trusted list gives the peer",
+		CIDRs:  cidrs("127.0.0.1/32"),
+		Header: map[string]string{"X-Real-IP": "fd00::9", "X-Forwarded-For": "fd00::1"},
+	},
+}
+
+var sourceLine = regexp.MustCompile(`source=(\S+)`)
+
+func Run(t *testing.T, testName string, source func(t *testing.T, s Scenario) string) {
+	t.Helper()
+	if name, ok := os.LookupEnv(scenarioEnv); ok {
+		for _, s := range Scenarios {
+			if s.Name == name {
+				fmt.Printf("source=%s\n", source(t, s))
+				return
+			}
+		}
+		t.Fatalf("unknown scenario %q", name)
+	}
+	for _, s := range Scenarios {
+		t.Run(s.Name, func(t *testing.T) {
+			env := []string{scenarioEnv + "=" + s.Name}
+			for _, kv := range os.Environ() {
+				if !strings.HasPrefix(kv, cidrsEnv+"=") && !strings.HasPrefix(kv, scenarioEnv+"=") {
+					env = append(env, kv)
+				}
+			}
+			if s.CIDRs != nil {
+				env = append(env, cidrsEnv+"="+*s.CIDRs)
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^"+testName+"$", "-test.count=1")
+			cmd.Env = env
+			out, err := cmd.CombinedOutput()
+			if err != nil {
+				t.Fatalf("scenario child failed: %v\n%s", err, out)
+			}
+			match := sourceLine.FindStringSubmatch(string(out))
+			if match == nil {
+				t.Fatalf("scenario child printed no source\n%s", out)
+			}
+			got := match[1]
+			if s.Want != "" {
+				if got != s.Want {
+					t.Fatalf("source %s, want %s", got, s.Want)
+				}
+				return
+			}
+			host, _, err := net.SplitHostPort(got)
+			if err != nil || host != s.PeerHost() {
+				t.Fatalf("source %s, want the TCP peer %s", got, s.PeerHost())
+			}
+		})
+	}
+}
