@@ -0,0 +1,60 @@
+package httpupgrade_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"github.com/xtls/xray-core/testing/trustedheader"
+	"github.com/xtls/xray-core/transport/internet"
+	. "github.com/xtls/xray-core/transport/internet/httpupgrade"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func sourceBehindHeaders(t *testing.T, s trustedheader.Scenario) string {
+	t.Helper()
+	listenIP := net.LocalHostIP
+	if s.IPv6 {
+		listenIP = net.LocalHostIPv6
+	}
+	listenPort := tcp.PickPort()
+	serverConfig := &internet.MemoryStreamConfig{
+		ProtocolName:     "httpupgrade",
+		ProtocolSettings: &Config{Path: "httpupgrade"},
+	}
+	if s.Trusted != nil {
+		serverConfig.SocketSettings = &internet.SocketConfig{TrustedXForwardedFor: s.Trusted}
+	}
+	listen, err := ListenHTTPUpgrade(context.Background(), listenIP, listenPort, serverConfig, func(conn stat.Connection) {
+		go func(c stat.Connection) {
+			defer c.Close()
+			var b [1024]byte
+			if _, err := c.Read(b[:]); err != nil {
+				return
+			}
+			_, _ = c.Write([]byte(c.RemoteAddr().String()))
+		}(conn)
+	})
+	common.Must(err)
+	defer listen.Close()
+
+	conn, err := Dial(context.Background(), net.TCPDestination(listenIP, listenPort), &internet.MemoryStreamConfig{
+		ProtocolName:     "httpupgrade",
+		ProtocolSettings: &Config{Path: "httpupgrade", Header: s.Header},
+	})
+	common.Must(err)
+	defer conn.Close()
+	_, err = conn.Write([]byte("probe"))
+	common.Must(err)
+
+	var b [1024]byte
+	n, err := conn.Read(b[:])
+	common.Must(err)
+	return string(b[:n])
+}
+
+func TestTrustedHeaderScenarios(t *testing.T) {
+	trustedheader.Run(t, "TestTrustedHeaderScenarios", sourceBehindHeaders)
+}
