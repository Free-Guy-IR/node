@@ -0,0 +1,87 @@
+package httpupgrade_test
+
+import (
+	"context"
+	gonet "net"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"github.com/xtls/xray-core/transport/internet"
+	. "github.com/xtls/xray-core/transport/internet/httpupgrade"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func sourceSeenBehindHeaders(t *testing.T, trusted []string, header map[string]string) string {
+	t.Helper()
+	listenPort := tcp.PickPort()
+	serverConfig := &internet.MemoryStreamConfig{
+		ProtocolName:     "httpupgrade",
+		ProtocolSettings: &Config{Path: "httpupgrade"},
+	}
+	if trusted != nil {
+		serverConfig.SocketSettings = &internet.SocketConfig{TrustedXForwardedFor: trusted}
+	}
+	listen, err := ListenHTTPUpgrade(context.Background(), net.LocalHostIP, listenPort, serverConfig, func(conn stat.Connection) {
+		go func(c stat.Connection) {
+			defer c.Close()
+			var b [1024]byte
+			if _, err := c.Read(b[:]); err != nil {
+				return
+			}
+			_, _ = c.Write([]byte(c.RemoteAddr().String()))
+		}(conn)
+	})
+	common.Must(err)
+	defer listen.Close()
+
+	conn, err := Dial(context.Background(), net.TCPDestination(net.LocalHostIP, listenPort), &internet.MemoryStreamConfig{
+		ProtocolName:     "httpupgrade",
+		ProtocolSettings: &Config{Path: "httpupgrade", Header: header},
+	})
+	common.Must(err)
+	defer conn.Close()
+	_, err = conn.Write([]byte("probe"))
+	common.Must(err)
+
+	var b [1024]byte
+	n, err := conn.Read(b[:])
+	common.Must(err)
+	return string(b[:n])
+}
+
+func requirePeerSource(t *testing.T, source string) {
+	t.Helper()
+	host, _, err := gonet.SplitHostPort(source)
+	if err != nil {
+		t.Fatalf("source %q: %v", source, err)
+	}
+	if host != "127.0.0.1" {
+		t.Fatalf("source %s, want the TCP peer 127.0.0.1", source)
+	}
+}
+
+func TestTrustedHeaderWinsOverForgedXForwardedFor(t *testing.T) {
+	source := sourceSeenBehindHeaders(t, []string{"CF-Connecting-IP"}, map[string]string{
+		"X-Forwarded-For":  "fd00::1, fd00::2",
+		"CF-Connecting-IP": "fd00::7",
+	})
+	if source != "[fd00::7]:0" {
+		t.Fatalf("source %s, want the trusted header value [fd00::7]:0", source)
+	}
+}
+
+func TestNoTrustedListUsesPeer(t *testing.T) {
+	requirePeerSource(t, sourceSeenBehindHeaders(t, nil, map[string]string{
+		"X-Forwarded-For":  "fd00::1",
+		"CF-Connecting-IP": "fd00::7",
+	}))
+}
+
+func TestInvalidTrustedHeaderFallsBackToPeer(t *testing.T) {
+	requirePeerSource(t, sourceSeenBehindHeaders(t, []string{"CF-Connecting-IP"}, map[string]string{
+		"X-Forwarded-For":  "fd00::1",
+		"CF-Connecting-IP": "not-an-ip",
+	}))
+}
