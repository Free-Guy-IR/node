+package http_test
+
+import (
+	"fmt"
+	gonet "net"
+	"net/http"
+	"os"
+	"os/exec"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/log"
+	. "github.com/xtls/xray-core/common/protocol/http"
+	"github.com/xtls/xray-core/testing/trustedheader"
+)
+
+func applySource(t *testing.T, s trustedheader.Scenario) string {
+	t.Helper()
+	header := http.Header{}
+	for key, value := range s.Header {
+		header.Set(key, value)
+	}
+	peer := &gonet.TCPAddr{IP: gonet.ParseIP(s.PeerHost()), Port: 12345}
+	return ApplyTrustedXForwardedFor(header, s.Trusted, peer).String()
+}
+
+func TestTrustedHeaderScenarios(t *testing.T) {
+	trustedheader.Run(t, "TestTrustedHeaderScenarios", applySource)
+}
+
+const invalidCIDRLogChild = "XRAY_TRUSTED_FORWARDER_LOG_TEST_CHILD"
+
+type recordingLogHandler struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+func (h *recordingLogHandler) Handle(msg log.Message) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.lines = append(h.lines, msg.String())
+}
+
+func TestInvalidCIDRListLogsOnce(t *testing.T) {
+	if os.Getenv(invalidCIDRLogChild) == "1" {
+		handler := &recordingLogHandler{}
+		log.RegisterHandler(handler)
+		header := http.Header{}
+		header.Set("CF-Connecting-IP", "fd00::7")
+		peer := &gonet.TCPAddr{IP: gonet.ParseIP("127.0.0.1"), Port: 12345}
+		for range 3 {
+			fmt.Println("source=" + ApplyTrustedXForwardedFor(header, []string{"CF-Connecting-IP"}, peer).String())
+		}
+		handler.mu.Lock()
+		defer handler.mu.Unlock()
+		invalid := 0
+		for _, line := range handler.lines {
+			if strings.Contains(line, "XRAY_TRUSTED_FORWARDER_CIDRS is not a valid CIDR list") {
+				invalid++
+			}
+		}
+		fmt.Printf("invalid_cidr_logs=%d\n", invalid)
+		return
+	}
+	tests := []struct {
+		cidrs       string
+		invalidLogs string
+	}{
+		{cidrs: "127.0.0.1/32, not-a-cidr", invalidLogs: "1"},
+		{cidrs: "127.0.0.1", invalidLogs: "1"},
+		{cidrs: "127.0.0.1/32", invalidLogs: "0"},
+	}
+	logs := regexp.MustCompile(`invalid_cidr_logs=(\d+)`)
+	for _, test := range tests {
+		t.Run(test.cidrs, func(t *testing.T) {
+			env := []string{invalidCIDRLogChild + "=1", "XRAY_TRUSTED_FORWARDER_CIDRS=" + test.cidrs}
+			for _, kv := range os.Environ() {
+				if !strings.HasPrefix(kv, "XRAY_TRUSTED_FORWARDER_CIDRS=") {
+					env = append(env, kv)
+				}
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestInvalidCIDRListLogsOnce$", "-test.count=1")
+			cmd.Env = env
+			out, err := cmd.CombinedOutput()
+			if err != nil {
+				t.Fatalf("child failed: %v\n%s", err, out)
+			}
+			match := logs.FindStringSubmatch(string(out))
+			if match == nil || match[1] != test.invalidLogs {
+				t.Fatalf("invalid CIDR error logs %v, want %s\n%s", match, test.invalidLogs, out)
+			}
+		})
+	}
+}
