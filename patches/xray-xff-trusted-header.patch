@@ -0,0 +1,46 @@
+package encoding
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	"github.com/xtls/xray-core/testing/trustedheader"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/peer"
+)
+
+type tunStream struct {
+	HunkConn
+	ctx context.Context
+}
+
+func (s tunStream) Context() context.Context {
+	return s.ctx
+}
+
+type tunMultiStream struct {
+	MultiHunkConn
+	ctx context.Context
+}
+
+func (s tunMultiStream) Context() context.Context {
+	return s.ctx
+}
+
+func tunSource(t *testing.T, s trustedheader.Scenario) string {
+	t.Helper()
+	ctx := peer.NewContext(metadata.NewIncomingContext(context.Background(), metadata.New(s.Header)), &peer.Peer{
+		Addr: &net.TCPAddr{IP: net.ParseIP(s.PeerHost()), Port: 12345},
+	})
+	tun := NewHunkConn(tunStream{ctx: ctx}, nil, s.Trusted).RemoteAddr().String()
+	multi := NewMultiHunkConn(tunMultiStream{ctx: ctx}, nil, s.Trusted).RemoteAddr().String()
+	if tun != multi {
+		t.Fatalf("Tun source %s differs from TunMulti source %s", tun, multi)
+	}
+	return tun
+}
+
+func TestTrustedHeaderScenarios(t *testing.T) {
+	trustedheader.Run(t, "TestTrustedHeaderScenarios", tunSource)
+}
