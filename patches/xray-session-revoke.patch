--- /dev/null
+++ b/app/proxyman/sessionrevoke/operation.go
@@ -0,0 +1,35 @@
+package sessionrevoke
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/features/inbound"
+	"github.com/xtls/xray-core/proxy"
+)
+
+func (op *RevokeUserOperation) ApplyInbound(ctx context.Context, handler inbound.Handler) error {
+	if op.Email == "" {
+		return errors.New("email must not be empty")
+	}
+
+	getter, ok := handler.(proxy.GetInbound)
+	if !ok {
+		return errors.New("can't get inbound proxy from handler")
+	}
+	manager, ok := getter.GetInbound().(proxy.UserManager)
+	if !ok {
+		return errors.New("proxy is not a UserManager")
+	}
+
+	current := manager.GetUser(ctx, op.Email)
+	if current != nil {
+		if err := manager.RemoveUser(ctx, op.Email); err != nil {
+			return err
+		}
+	}
+
+	closed := Revoke(handler.Tag(), op.Email, current)
+	errors.LogInfo(ctx, "revoked user ", op.Email, " on inbound ", handler.Tag(), ", closed ", closed, " live sessions")
+	return nil
+}
