index 0000000..f02fbb5
--- /dev/null
+++ b/app/proxyman/sessionrevoke/session.go
@@ -0,0 +1,168 @@
+package sessionrevoke
+
+import (
+	"context"
+	"io"
+	"strings"
+	"sync"
+	"weak"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+)
+
+type userKey struct {
+	tag   string
+	email string
+}
+
+func newUserKey(tag, email string) userKey {
+	return userKey{tag: tag, email: strings.ToLower(email)}
+}
+
+type Session struct {
+	tag    string
+	conn   io.Closer
+	cancel context.CancelFunc
+	key    userKey
+	user   *protocol.MemoryUser
+	bound  bool
+	closed bool
+}
+
+const minPruneThreshold = 1024
+
+type registry struct {
+	sync.Mutex
+	sessions map[userKey]map[*Session]struct{}
+	revoked  map[weak.Pointer[protocol.MemoryUser]]struct{}
+	pruneAt  int
+}
+
+var active = &registry{
+	sessions: make(map[userKey]map[*Session]struct{}),
+	revoked:  make(map[weak.Pointer[protocol.MemoryUser]]struct{}),
+	pruneAt:  minPruneThreshold,
+}
+
+func (r *registry) revokeLocked(user *protocol.MemoryUser) {
+	r.revoked[weak.Make(user)] = struct{}{}
+	if len(r.revoked) < r.pruneAt {
+		return
+	}
+	for revoked := range r.revoked {
+		if revoked.Value() == nil {
+			delete(r.revoked, revoked)
+		}
+	}
+	r.pruneAt = max(minPruneThreshold, 2*len(r.revoked))
+}
+
+func Track(tag string, conn io.Closer, cancel context.CancelFunc) *Session {
+	return &Session{tag: tag, conn: conn, cancel: cancel}
+}
+
+func (s *Session) Wrap(d routing.Dispatcher) routing.Dispatcher {
+	return &dispatcher{Dispatcher: d, session: s}
+}
+
+func (s *Session) Release() {
+	active.Lock()
+	defer active.Unlock()
+
+	if !s.bound {
+		return
+	}
+	s.bound = false
+	members := active.sessions[s.key]
+	delete(members, s)
+	if len(members) == 0 {
+		delete(active.sessions, s.key)
+	}
+}
+
+func (s *Session) bind(ctx context.Context) error {
+	inbound := session.InboundFromContext(ctx)
+	if inbound == nil || inbound.User == nil || inbound.User.Email == "" {
+		return nil
+	}
+	user := inbound.User
+
+	active.Lock()
+	defer active.Unlock()
+
+	if s.closed {
+		return errors.New("session of user ", user.Email, " was revoked")
+	}
+	if len(active.revoked) > 0 {
+		if _, revoked := active.revoked[weak.Make(user)]; revoked {
+			s.closeLocked()
+			return errors.New("user ", user.Email, " was revoked")
+		}
+	}
+	if s.bound {
+		return nil
+	}
+
+	s.key = newUserKey(s.tag, user.Email)
+	s.user = user
+	s.bound = true
+	members := active.sessions[s.key]
+	if members == nil {
+		members = make(map[*Session]struct{})
+		active.sessions[s.key] = members
+	}
+	members[s] = struct{}{}
+	return nil
+}
+
+func (s *Session) closeLocked() {
+	if s.closed {
+		return
+	}
+	s.closed = true
+	s.cancel()
+	go s.conn.Close()
+}
+
+func Revoke(tag, email string, current *protocol.MemoryUser) int {
+	active.Lock()
+	defer active.Unlock()
+
+	if current != nil {
+		active.revokeLocked(current)
+	}
+
+	closed := 0
+	for s := range active.sessions[newUserKey(tag, email)] {
+		active.revokeLocked(s.user)
+		if !s.closed {
+			closed++
+		}
+		s.closeLocked()
+	}
+	return closed
+}
+
+type dispatcher struct {
+	routing.Dispatcher
+	session *Session
+}
+
+func (d *dispatcher) Dispatch(ctx context.Context, dest net.Destination) (*transport.Link, error) {
+	if err := d.session.bind(ctx); err != nil {
+		return nil, err
+	}
+	return d.Dispatcher.Dispatch(ctx, dest)
+}
+
+func (d *dispatcher) DispatchLink(ctx context.Context, dest net.Destination, link *transport.Link) error {
+	if err := d.session.bind(ctx); err != nil {
+		return err
+	}
+	return d.Dispatcher.DispatchLink(ctx, dest, link)
+}
