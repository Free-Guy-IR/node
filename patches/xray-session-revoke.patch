@@ -0,0 +1,263 @@
+package sessionrevoke
+
+import (
+	"context"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+	"weak"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport"
+)
+
+type fakeConn struct {
+	once   sync.Once
+	closed chan struct{}
+}
+
+func newFakeConn() *fakeConn {
+	return &fakeConn{closed: make(chan struct{})}
+}
+
+func (c *fakeConn) Close() error {
+	c.once.Do(func() { close(c.closed) })
+	return nil
+}
+
+func (c *fakeConn) isClosed(wait time.Duration) bool {
+	select {
+	case <-c.closed:
+		return true
+	case <-time.After(wait):
+		return false
+	}
+}
+
+type fakeDispatcher struct {
+	dispatched int
+}
+
+func (d *fakeDispatcher) Type() interface{} { return nil }
+func (d *fakeDispatcher) Start() error      { return nil }
+func (d *fakeDispatcher) Close() error      { return nil }
+
+func (d *fakeDispatcher) Dispatch(ctx context.Context, dest net.Destination) (*transport.Link, error) {
+	d.dispatched++
+	return &transport.Link{}, nil
+}
+
+func (d *fakeDispatcher) DispatchLink(ctx context.Context, dest net.Destination, link *transport.Link) error {
+	d.dispatched++
+	return nil
+}
+
+type trackedConn struct {
+	conn    *fakeConn
+	ctx     context.Context
+	session *Session
+	wrapped *fakeDispatcher
+}
+
+func openTracked(t *testing.T, tag string, user *protocol.MemoryUser) (*trackedConn, error) {
+	t.Helper()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	ctx = session.ContextWithInbound(ctx, &session.Inbound{Tag: tag, User: user})
+
+	conn := newFakeConn()
+	tracked := &trackedConn{conn: conn, ctx: ctx, session: Track(tag, conn, cancel), wrapped: &fakeDispatcher{}}
+	t.Cleanup(tracked.session.Release)
+
+	err := tracked.session.Wrap(tracked.wrapped).DispatchLink(ctx, net.TCPDestination(net.LocalHostIP, 80), &transport.Link{})
+	return tracked, err
+}
+
+func memoryUser(email string) *protocol.MemoryUser {
+	return &protocol.MemoryUser{Email: email}
+}
+
+func TestRevokeClosesOnlyTheRevokedUsersSessions(t *testing.T) {
+	victimUser := memoryUser("victim@revoke-test")
+	victim, err := openTracked(t, "in-a", victimUser)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sameUserOtherInbound, err := openTracked(t, "in-b", victimUser)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bystander, err := openTracked(t, "in-a", memoryUser("bystander@revoke-test"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if closed := Revoke("in-a", "VICTIM@revoke-test", nil); closed != 1 {
+		t.Fatalf("closed %d sessions, want 1", closed)
+	}
+
+	if !victim.conn.isClosed(time.Second) {
+		t.Fatal("victim connection was not closed")
+	}
+	if victim.ctx.Err() == nil {
+		t.Fatal("victim context was not cancelled")
+	}
+	if bystander.conn.isClosed(50 * time.Millisecond) {
+		t.Fatal("bystander connection on the same inbound was closed")
+	}
+	if sameUserOtherInbound.conn.isClosed(50 * time.Millisecond) {
+		t.Fatal("the same user's connection on another inbound was closed")
+	}
+}
+
+func TestRevokedUserCannotBindANewSession(t *testing.T) {
+	user := memoryUser("late@revoke-test")
+	Revoke("in-late", user.Email, user)
+
+	late, err := openTracked(t, "in-late", user)
+	if err == nil {
+		t.Fatal("a connection authenticated with the revoked user was dispatched")
+	}
+	if late.wrapped.dispatched != 0 {
+		t.Fatal("the revoked connection reached the inner dispatcher")
+	}
+	if !late.conn.isClosed(time.Second) {
+		t.Fatal("the revoked connection was not closed")
+	}
+
+	readded, err := openTracked(t, "in-late", memoryUser("late@revoke-test"))
+	if err != nil {
+		t.Fatalf("a re-added user with the same email was refused: %v", err)
+	}
+	if readded.wrapped.dispatched != 1 {
+		t.Fatal("the re-added user's connection was not dispatched")
+	}
+}
+
+func TestRevokeClosesEveryStreamOfARevokedUserOnLaterDispatch(t *testing.T) {
+	user := memoryUser("stream@revoke-test")
+	first, err := openTracked(t, "in-stream", user)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	Revoke("in-stream", user.Email, nil)
+	if !first.conn.isClosed(time.Second) {
+		t.Fatal("the live stream was not closed")
+	}
+
+	second, err := openTracked(t, "in-stream", user)
+	if err == nil || second.wrapped.dispatched != 0 {
+		t.Fatal("a later stream carrying the revoked user was dispatched")
+	}
+}
+
+func TestReleasedSessionIsNotClosedByRevoke(t *testing.T) {
+	user := memoryUser("released@revoke-test")
+	tracked, err := openTracked(t, "in-released", user)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tracked.session.Release()
+
+	if closed := Revoke("in-released", user.Email, nil); closed != 0 {
+		t.Fatalf("closed %d released sessions", closed)
+	}
+	if tracked.conn.isClosed(50 * time.Millisecond) {
+		t.Fatal("a released session was closed")
+	}
+}
+
+func TestAnonymousSessionsAreNotTracked(t *testing.T) {
+	tracked, err := openTracked(t, "in-anon", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tracked.session.bound {
+		t.Fatal("a session without a user was registered")
+	}
+}
+
+func TestRevokedSetForgetsCollectedUsers(t *testing.T) {
+	tracked := make([]weak.Pointer[protocol.MemoryUser], 0, minPruneThreshold)
+	for i := 0; i < minPruneThreshold; i++ {
+		user := memoryUser("gc@revoke-test")
+		tracked = append(tracked, weak.Make(user))
+		Revoke("in-gc", user.Email, user)
+	}
+
+	for i := 0; i < 64*minPruneThreshold; i++ {
+		if i%minPruneThreshold == 0 {
+			runtime.GC()
+		}
+		Revoke("in-gc", "gc@revoke-test", memoryUser("gc@revoke-test"))
+
+		active.Lock()
+		remaining := 0
+		for _, user := range tracked {
+			if _, ok := active.revoked[user]; ok {
+				remaining++
+			}
+		}
+		size := len(active.revoked)
+		active.Unlock()
+		if remaining == 0 {
+			if size > 4*minPruneThreshold {
+				t.Fatalf("the revoked set holds %d entries after pruning", size)
+			}
+			return
+		}
+	}
+	t.Fatal("revoked entries of collected users were never pruned")
+}
+
+func TestRevokeStaysCheapForLargeBatches(t *testing.T) {
+	started := time.Now()
+	for i := 0; i < 50000; i++ {
+		Revoke("in-batch", "batch@revoke-test", memoryUser("batch@revoke-test"))
+	}
+	if elapsed := time.Since(started); elapsed > 5*time.Second {
+		t.Fatalf("50000 revocations took %s", elapsed)
+	}
+}
+
+func TestConcurrentBindReleaseAndRevoke(t *testing.T) {
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				ctx, cancel := context.WithCancel(context.Background())
+				ctx = session.ContextWithInbound(ctx, &session.Inbound{Tag: "in-race", User: memoryUser("race@revoke-test")})
+				s := Track("in-race", newFakeConn(), cancel)
+				_ = s.Wrap(&fakeDispatcher{}).DispatchLink(ctx, net.TCPDestination(net.LocalHostIP, 80), &transport.Link{})
+				s.Release()
+				cancel()
+			}
+		}()
+	}
+
+	for i := 0; i < 200; i++ {
