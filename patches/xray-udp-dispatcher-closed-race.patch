+package udp_test
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol/udp"
+	"github.com/xtls/xray-core/transport"
+	. "github.com/xtls/xray-core/transport/internet/udp"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func TestDispatchesRacingTheTerminationOfAFailedFlowDoNotRace(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	td := &TestDispatcher{
+		OnDispatch: func(ctx context.Context, dest net.Destination) (*transport.Link, error) {
+			downlinkReader, _ := pipe.New(pipe.WithSizeLimit(1024))
+			_, uplinkWriter := pipe.New(pipe.WithSizeLimit(1024))
+			uplinkWriter.Close()
+			return &transport.Link{Reader: downlinkReader, Writer: uplinkWriter}, nil
+		},
+	}
+	dispatcher := NewDispatcher(td, func(ctx context.Context, packet *udp.Packet) {})
+	dest := net.UDPDestination(net.LocalHostIP, 53)
+	var wg sync.WaitGroup
+	for g := 0; g < 4; g++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 300; i++ {
+				b := buf.New()
+				b.WriteString("abcd")
+				dispatcher.Dispatch(ctx, dest, b)
+			}
+		}()
+	}
+	wg.Wait()
+}
