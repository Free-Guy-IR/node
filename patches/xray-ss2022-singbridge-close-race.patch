+			w.access.Unlock()
+			buffer.Write(bb.Bytes())
 			var destination net.Destination
 			if bb.UDP != nil {
 				destination = *bb.UDP
@@ -65,13 +76,22 @@ func (w *PacketConnWrapper) ReadPacket(buffer *B.Buffer) (addr M.Socksaddr, err
 			return ToSocksaddr(destination), nil
 		}
 	}
+	w.access.Unlock()
 	mb, err := w.ReadMultiBuffer()
 	nb, bb := buf.SplitFirst(mb)
 	if bb == nil {
 		return M.Socksaddr{}, nil
 	} else {
+		w.access.Lock()
+		if w.closed {
+			w.access.Unlock()
+			bb.Release()
+			buf.ReleaseMulti(nb)
+			return M.Socksaddr{}, io.ErrClosedPipe
+		}
+		w.cached, _ = buf.MergeMulti(w.cached, nb)
+		w.access.Unlock()
