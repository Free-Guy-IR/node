+package websocket_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	. "github.com/xtls/xray-core/transport/internet/websocket"
+)
+
+func TestEarlyDataConnAddressesBeforeFirstWrite(t *testing.T) {
+	listenPort := tcp.PickPort()
+	listen, err := ListenWS(context.Background(), net.LocalHostIP, listenPort, &internet.MemoryStreamConfig{
+		ProtocolName:     "websocket",
+		ProtocolSettings: &Config{Path: "ws"},
+	}, func(conn stat.Connection) {
+		go func(c stat.Connection) {
+			defer c.Close()
+			var b [1024]byte
+			_, _ = c.Read(b[:])
+		}(conn)
+	})
+	common.Must(err)
+	defer listen.Close()
+
+	conn, err := Dial(context.Background(), net.TCPDestination(net.LocalHostIP, listenPort), &internet.MemoryStreamConfig{
+		ProtocolName:     "websocket",
+		ProtocolSettings: &Config{Path: "ws", Ed: 2048},
+	})
+	common.Must(err)
+	defer conn.Close()
+
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("reading the addresses of an early-data connection before its first write panicked: %v", r)
+			}
+		}()
+		_ = conn.LocalAddr()
+		_ = conn.RemoteAddr()
+	}()
+
+	_, err = conn.Write([]byte("early data"))
+	common.Must(err)
+	if conn.LocalAddr() == nil || conn.RemoteAddr() == nil {
+		t.Fatal("an early-data connection has no addresses after its first write")
+	}
+}
