@@ -0,0 +1,167 @@
+package freedom
+
+import (
+	"context"
+	gonet "net"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/utils"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+type systemDialer struct{}
+
+func (systemDialer) Dial(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+	return internet.DialSystem(ctx, dest, nil)
+}
+
+func (systemDialer) DestIpAddress() net.IP {
+	return nil
+}
+
+func (systemDialer) SetOutboundGateway(ctx context.Context, ob *session.Outbound) {}
+
+func loopbackListener(t *testing.T) (net.Port, *atomic.Int32) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	accepted := new(atomic.Int32)
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			accepted.Add(1)
+			conn.Close()
+		}
+	}()
+	return net.Port(ln.Addr().(*net.TCPAddr).Port), accepted
+}
+
+func processFrom(t *testing.T, inboundName string, target net.Destination) error {
+	t.Helper()
+	h := new(Handler)
+	if err := h.Init(&Config{}, policy.DefaultManager{}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	ctx = session.ContextWithInbound(ctx, &session.Inbound{Name: inboundName})
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target}})
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	uplinkWriter.Close()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	return h.Process(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter}, systemDialer{})
+}
+
+func TestOnlyUserInboundsRefuseTheLocalHost(t *testing.T) {
+	for name, want := range map[string]bool{
+		"vless": true, "vmess": true, "trojan": true, "hysteria": true, "wireguard": true,
+		"shadowsocks": true, "shadowsocks-2022": true, "shadowsocks-2022-multi": true, "shadowsocks-2022-relay": true,
+		"dokodemo-door": false, "socks": false, "http": false, "": false,
+	} {
+		if got := refusesLocalHost(&session.Inbound{Name: name}); got != want {
+			t.Errorf("inbound %q refuses the local host: %v, want %v", name, got, want)
+		}
+	}
+	if refusesLocalHost(nil) {
+		t.Error("a connection without an inbound refuses the local host")
+	}
+}
+
+func TestTheLocalHostIsLoopbackAndUnspecifiedOnly(t *testing.T) {
+	for addr, want := range map[string]bool{
+		"127.0.0.1": true, "127.255.255.254": true, "::1": true, "::ffff:127.0.0.1": true, "0.0.0.0": true, "::": true,
+		"100.64.0.1": false, "10.0.0.1": false, "172.16.0.1": false, "192.168.1.1": false, "169.254.1.1": false,
+		"fe80::1": false, "8.8.8.8": false, "2001:db8::1": false, "localhost": false,
+	} {
+		if got := isLocalHostAddress(net.ParseAddress(addr)); got != want {
+			t.Errorf("%s is the local host: %v, want %v", addr, got, want)
+		}
+	}
+}
+
+func TestAUserInboundCannotReachALoopbackListenerThroughFreedom(t *testing.T) {
+	for _, target := range []string{"127.0.0.1", "localhost"} {
+		port, accepted := loopbackListener(t)
+		err := processFrom(t, "vless", net.TCPDestination(net.ParseAddress(target), port))
+		if err == nil || !strings.Contains(err.Error(), "local host address") {
+			t.Fatalf("vless to %s:%d: %v, want a refusal", target, port, err)
+		}
+		time.Sleep(100 * time.Millisecond)
+		if target == "127.0.0.1" && accepted.Load() != 0 {
+			t.Fatalf("vless to %s:%d: the listener accepted %d connections before the refusal", target, port, accepted.Load())
+		}
+	}
+}
+
+func TestOtherInboundsStillReachALoopbackListenerThroughFreedom(t *testing.T) {
+	for _, name := range []string{"socks", "http", "dokodemo-door"} {
+		port, accepted := loopbackListener(t)
+		if err := processFrom(t, name, net.TCPDestination(net.LocalHostIP, port)); err != nil && strings.Contains(err.Error(), "local host address") {
+			t.Fatalf("%s to 127.0.0.1:%d was refused: %v", name, port, err)
+		}
+		deadline := time.Now().Add(2 * time.Second)
+		for accepted.Load() == 0 && time.Now().Before(deadline) {
+			time.Sleep(20 * time.Millisecond)
+		}
+		if accepted.Load() == 0 {
+			t.Fatalf("%s to 127.0.0.1:%d never reached the listener", name, port)
+		}
+	}
+}
+
+func TestAUserInboundDropsUDPPacketsAddressedToTheLocalHost(t *testing.T) {
+	for _, refuse := range []bool{false, true} {
+		target, err := gonet.ListenPacket("udp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		sender, err := gonet.ListenPacket("udp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		w := &PacketWriter{
+			PacketConnWrapper: &internet.PacketConnWrapper{PacketConn: sender, Dest: target.LocalAddr()},
+			Handler:           &Handler{config: &Config{}},
+			ResolvedUDPAddr:   utils.NewTypedSyncMap[string, net.Address](),
+			RefuseLocalHost:   refuse,
+		}
+		b := buf.New()
+		b.WriteString("probe")
+		b.UDP = &net.Destination{Network: net.Network_UDP, Address: net.LocalHostIP, Port: net.Port(target.LocalAddr().(*net.UDPAddr).Port)}
+		if err := w.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+			t.Fatal(err)
+		}
+		target.SetReadDeadline(time.Now().Add(500 * time.Millisecond))
+		got := make([]byte, 16)
+		n, _, err := target.ReadFrom(got)
+		delivered := err == nil && string(got[:n]) == "probe"
+		if delivered == refuse {
+			t.Errorf("RefuseLocalHost %v: packet to 127.0.0.1 delivered %v", refuse, delivered)
+		}
+		target.Close()
+		sender.Close()
+	}
+}
