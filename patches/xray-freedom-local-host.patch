+func refusesLocalHost(inbound *session.Inbound) bool {
+	if inbound == nil {
+		return false
+	}
+	switch inbound.Name {
+	case "vless", "vmess", "trojan", "hysteria", "wireguard":
+		return true
+	}
+	return strings.HasPrefix(inbound.Name, "shadowsocks")
+}
+
+func isLoopbackAddress(addr net.Address) bool {
+	return addr != nil && addr.Family().IsIP() && addr.IP().IsLoopback()
+}
+
+func isLocalHostAddress(addr net.Address) bool {
+	return isLoopbackAddress(addr) || addr != nil && addr.Family().IsIP() && addr.IP().IsUnspecified()
+}
+
+func remoteIsLoopback(conn net.Conn) bool {
+	switch addr := conn.RemoteAddr().(type) {
+	case *net.TCPAddr:
+		return addr.IP.IsLoopback()
+	case *net.UDPAddr:
+		return addr.IP.IsLoopback()
+	}
+	return false
+}
