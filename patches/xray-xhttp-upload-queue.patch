+package splithttp_test
+
+import (
+	"testing"
+	"time"
+
+	. "github.com/xtls/xray-core/transport/internet/splithttp"
+)
+
+func TestCloseReleasesAPushBlockedOnAFullQueue(t *testing.T) {
+	const maxBufferedPosts = 30
+	q := NewUploadQueue(maxBufferedPosts)
+	for i := 0; i < maxBufferedPosts; i++ {
+		if err := q.Push(Packet{Payload: []byte("x"), Seq: uint64(i)}); err != nil {
+			t.Fatalf("push %d: %v", i+1, err)
+		}
+	}
+	pushed := make(chan error, 1)
+	go func() {
+		pushed <- q.Push(Packet{Payload: []byte("x"), Seq: maxBufferedPosts})
+	}()
+	select {
+	case err := <-pushed:
+		t.Fatalf("push %d into a full queue with no reader returned %v instead of waiting", maxBufferedPosts+1, err)
+	case <-time.After(200 * time.Millisecond):
+	}
+	closed := make(chan error, 1)
+	go func() {
+		closed <- q.Close()
+	}()
+	select {
+	case <-closed:
+	case <-time.After(3 * time.Second):
+		t.Fatalf("Close is still blocked behind push %d after 3s", maxBufferedPosts+1)
+	}
+	select {
+	case err := <-pushed:
+		if err == nil {
+			t.Fatalf("push %d succeeded after Close", maxBufferedPosts+1)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatalf("push %d is still blocked 3s after Close returned", maxBufferedPosts+1)
+	}
+}
+
+func TestPacketsPushedBeforeAReaderArrivesAreReadInSequenceOrder(t *testing.T) {
+	q := NewUploadQueue(30)
+	for _, seq := range []uint64{2, 0, 1} {
+		if err := q.Push(Packet{Payload: []byte{byte('a' + seq)}, Seq: seq}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := make([]byte, 0, 3)
+	b := make([]byte, 8)
+	for len(got) < 3 {
+		n, err := q.Read(b)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, b[:n]...)
+	}
+	if string(got) != "abc" {
+		t.Fatalf("read %q, want abc", got)
+	}
+	if err := q.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := q.Read(b); n != 0 || err == nil {
+		t.Fatalf("read after Close: %d, %v, want 0 and an error", n, err)
+	}
+}
