+package wireguard
+
+import (
+	"context"
+	gonet "net"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+func TestClosingABindTwiceDoesNotPanic(t *testing.T) {
+	b := &bind{
+		ctx: context.Background(),
+		listenFunc: func(context.Context) (gonet.PacketConn, error) {
+			return gonet.ListenPacket("udp", "127.0.0.1:0")
+		},
+	}
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("closing the bind a second time panicked: %v", r)
+		}
+	}()
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestADialThroughAClosedTunDoesNotPanic(t *testing.T) {
+	dev, tnet, err := CreateNetTUN([]netip.Addr{netip.MustParseAddr("10.0.0.2")}, nil, 1420, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dev.Close(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("dialing through a closed tun panicked: %v", r)
+		}
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if conn, err := tnet.DialContext(ctx, "tcp", "10.0.0.1:80"); err == nil {
+		conn.Close()
+		t.Fatal("a tcp dial through a closed tun succeeded")
+	}
+	if conn, err := tnet.Dial("udp", "10.0.0.1:53"); err == nil {
+		_, _ = conn.Write([]byte("after close"))
+		conn.Close()
+	}
+}
+
+func TestAClosedHandlerRefusesToComeUp(t *testing.T) {
+	h := &Handler{}
+	if err := h.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.up(context.Background()); err == nil {
+		t.Fatal("a closed handler came up")
+	}
+}
