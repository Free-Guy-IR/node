@@ -0,0 +1,33 @@
+package wireguard
+
+import (
+	goerrors "errors"
+	gonet "net"
+	"testing"
+
+	"golang.zx2c4.com/wireguard/conn"
+)
+
+func TestClosingABindTwiceDoesNotPanic(t *testing.T) {
+	bind := &netBind{readQueue: make(chan *netReadInfo), workers: 1}
+	receivers, _, err := bind.Open(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("closing the bind a second time panicked: %v", r)
+		}
+	}()
+	if err := bind.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := bind.Close(); err != nil {
+		t.Fatal(err)
+	}
+	sizes := make([]int, 1)
+	endpoints := make([]conn.Endpoint, 1)
+	if _, err := receivers[0]([][]byte{make([]byte, 1)}, sizes, endpoints); !goerrors.Is(err, gonet.ErrClosed) {
+		t.Fatalf("a receive after Close returned %v, want net.ErrClosed", err)
+	}
+}
