 func (bind *netBind) Close() error {
 	errors.LogDebug(context.Background(), "bind closed")
 	if bind.closedCh != nil {
-		close(bind.closedCh)
+		select {
+		case <-bind.closedCh:
+		default:
+			close(bind.closedCh)
+		}
 	}
 	return nil
 }
