+package wireguard
+
+import (
+	"net/netip"
+	"testing"
+	"time"
+)
+
+func TestCloseWithPacketInFlightDoesNotPanic(t *testing.T) {
+	for round := range 20 {
+		dev, tnet, err := CreateNetTUN([]netip.Addr{netip.MustParseAddr("10.0.0.2")}, nil, 1420, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		conn, err := tnet.DialUDPAddrPort(netip.AddrPort{}, netip.MustParseAddrPort("10.0.0.1:53"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		writing := make(chan struct{})
+		result := make(chan any, 1)
+		go func() {
+			defer func() {
+				result <- recover()
+			}()
+			close(writing)
+			for range 2 * netTunQueue {
+				if _, err := conn.Write([]byte("query in flight")); err != nil {
+					return
+				}
+			}
+		}()
+		<-writing
+		time.Sleep(20 * time.Millisecond)
+		if err := dev.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := dev.Close(); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case r := <-result:
+			if r != nil {
+				t.Fatalf("round %d: closing the tun with a packet in flight panicked: %v", round, r)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatalf("round %d: the in-flight write never returned after Close", round)
+		}
+	}
+}
