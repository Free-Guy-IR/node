+package inbound
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/proxy/vmess"
+	"github.com/xtls/xray-core/proxy/vmess/aead"
+)
+
+const (
+	heldID = "6a3e0f5c-2b1d-4c8e-9f7a-1d2e3f4a5b6c"
+	ownID  = "0d9c8b7a-6f5e-4d3c-8b2a-1f0e9d8c7b6a"
+)
+
+func ownerTestUser(email, id string) *protocol.MemoryUser {
+	account, err := (&vmess.Account{Id: id}).AsAccount()
+	common.Must(err)
+	return &protocol.MemoryUser{Email: email, Account: account}
+}
+
+func ownerTestHandler() *Handler {
+	return &Handler{clients: vmess.NewTimedUserValidator(), usersByEmail: newUserByEmail(&DefaultConfig{})}
+}
+
+func requireAuthenticatesAsItself(t *testing.T, h *Handler, user *protocol.MemoryUser) {
+	t.Helper()
+	authID := aead.CreateAuthID(user.Account.(*vmess.MemoryAccount).ID.CmdKey(), time.Now().Unix())
+	got, _, err := h.clients.GetAEAD(authID[:])
+	if err != nil || got != user {
+		t.Fatalf("%s's id authenticates as %p (%v), want %p", user.Email, got, err, user)
+	}
+}
+
+func requireEmailsMatchTheValidator(t *testing.T, h *Handler) {
+	t.Helper()
+	held := make(map[*protocol.MemoryUser]bool)
+	for _, user := range h.clients.GetUsers() {
+		held[user] = true
+		if got := h.usersByEmail.Get(user.Email); got != user {
+			t.Fatalf("the validator holds %s, but its email maps to %p", user.Email, got)
+		}
+	}
+	h.usersByEmail.Lock()
+	defer h.usersByEmail.Unlock()
+	for email, user := range h.usersByEmail.cache {
+		if !held[user] {
+			t.Fatalf("%s is registered by email but the validator does not hold it", email)
+		}
+	}
+}
+
+func TestAUserTheValidatorRefusesLeavesNoEmailEntry(t *testing.T) {
+	ctx := context.Background()
+	h := ownerTestHandler()
+	a := ownerTestUser("a@example.com", heldID)
+	if err := h.AddUser(ctx, a); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.AddUser(ctx, ownerTestUser("b@example.com", heldID)); err == nil {
+		t.Fatal("b was added with the id a holds")
+	}
+	if got := h.GetUser(ctx, "b@example.com"); got != nil {
+		t.Fatal("the refused b is still registered by email")
+	}
+	requireAuthenticatesAsItself(t, h, a)
+	requireEmailsMatchTheValidator(t, h)
+
+	if err := h.AddUser(ctx, ownerTestUser("b@example.com", ownID)); err != nil {
+		t.Fatalf("b could not be added with its own id after the refusal: %v", err)
+	}
+	if err := h.RemoveUser(ctx, "a@example.com"); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.AddUser(ctx, ownerTestUser("c@example.com", heldID)); err != nil {
+		t.Fatalf("c could not take the id a released: %v", err)
+	}
+	requireEmailsMatchTheValidator(t, h)
+}
+
+func TestRefusedAddsRacingARemoveAndReaddKeepEveryEmailEntryTrue(t *testing.T) {
+	ctx := context.Background()
+	for round := 0; round < 200; round++ {
+		h := ownerTestHandler()
+		a := ownerTestUser("a@example.com", heldID)
+		if err := h.AddUser(ctx, a); err != nil {
+			t.Fatal(err)
+		}
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 30; i++ {
+				_ = h.AddUser(ctx, ownerTestUser("b@example.com", heldID))
+			}
+		}()
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 30; i++ {
+				_ = h.RemoveUser(ctx, "b@example.com")
+				_ = h.AddUser(ctx, ownerTestUser("b@example.com", ownID))
+			}
+		}()
+		wg.Wait()
+		requireAuthenticatesAsItself(t, h, a)
+		requireEmailsMatchTheValidator(t, h)
+	}
+}
