@@ -0,0 +1,148 @@
+package trojan
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+const (
+	heldPassword = "shared-trojan-password"
+	ownPassword  = "own-trojan-password"
+)
+
+func ownerTestUser(email, password string) *protocol.MemoryUser {
+	account, err := (&Account{Password: password}).AsAccount()
+	common.Must(err)
+	return &protocol.MemoryUser{Email: email, Account: account}
+}
+
+func keyOf(user *protocol.MemoryUser) string {
+	return hexString(user.Account.(*MemoryAccount).Key)
+}
+
+func emailOf(user *protocol.MemoryUser) string {
+	if user == nil {
+		return "nobody"
+	}
+	return user.Email
+}
+
+func requireEveryHeldUserAuthenticatesAsItself(t *testing.T, v *Validator) {
+	t.Helper()
+	for _, user := range v.GetAll() {
+		if got := v.Get(keyOf(user)); got != user {
+			t.Fatalf("%s is held but its password authenticates as %s", user.Email, emailOf(got))
+		}
+	}
+	v.users.Range(func(_, value any) bool {
+		holder := value.(*protocol.MemoryUser)
+		if holder.Email != "" && v.GetByEmail(holder.Email) != holder {
+			t.Fatalf("a password is held by %s, which the validator no longer holds", holder.Email)
+		}
+		return true
+	})
+}
+
+func TestAUserWhoseCredentialAnotherUserHoldsIsRefused(t *testing.T) {
+	v := new(Validator)
+	a := ownerTestUser("a@example.com", heldPassword)
+	if err := v.Add(a); err != nil {
+		t.Fatal(err)
+	}
+
+	b := ownerTestUser("b@example.com", heldPassword)
+	if err := v.Add(b); err == nil {
+		t.Fatalf("b was added with the password a holds")
+	}
+	if got := v.GetByEmail("b@example.com"); got != nil {
+		t.Fatalf("the refused b is still registered by email")
+	}
+	if got := v.Get(keyOf(b)); got != a {
+		t.Fatalf("the shared password authenticates as %s, want a", emailOf(got))
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+
+	if err := v.Add(ownerTestUser("b@example.com", ownPassword)); err != nil {
+		t.Fatalf("b could not be added with its own password after the refusal: %v", err)
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+}
+
+func TestRemovingAUserLeavesACredentialAnotherUserHolds(t *testing.T) {
+	v := new(Validator)
+	b := ownerTestUser("b@example.com", heldPassword)
+	if err := v.Add(b); err != nil {
+		t.Fatal(err)
+	}
+	a := ownerTestUser("a@example.com", heldPassword)
+	v.email.Store("a@example.com", a)
+
+	if err := v.Del("a@example.com"); err != nil {
+		t.Fatal(err)
+	}
+	if got := v.Get(keyOf(b)); got != b {
+		t.Fatalf("removing a left b's password authenticating as %s", emailOf(got))
+	}
+	if got := v.GetByEmail("a@example.com"); got != nil {
+		t.Fatalf("a is still held after its removal")
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+}
+
+func TestAUserReaddedWithItsOwnCredentialKeepsIt(t *testing.T) {
+	v := new(Validator)
+	if err := v.Add(ownerTestUser("a@example.com", heldPassword)); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Del("a@example.com"); err != nil {
+		t.Fatal(err)
+	}
+	again := ownerTestUser("A@example.com", heldPassword)
+	if err := v.Add(again); err != nil {
+		t.Fatalf("a could not be added again after its removal: %v", err)
+	}
+	if got := v.Get(keyOf(again)); got != again {
+		t.Fatalf("the re-added a authenticates as %s", emailOf(got))
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+}
+
+func TestUsersWithoutAnEmailMayShareACredential(t *testing.T) {
+	v := new(Validator)
+	first := ownerTestUser("", heldPassword)
+	second := ownerTestUser("", heldPassword)
+	if err := v.Add(first); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Add(second); err != nil {
+		t.Fatalf("a second user without an email was refused: %v", err)
+	}
+	if got := v.Get(keyOf(first)); got != second {
+		t.Fatalf("the password authenticates as %p, want the last user added without an email", got)
+	}
+}
+
+func TestEveryHeldUserAuthenticatesAsItselfUnderChurn(t *testing.T) {
+	for round := 0; round < 200; round++ {
+		v := new(Validator)
+		var wg sync.WaitGroup
+		churn := func(email string) {
+			defer wg.Done()
+			for i := 0; i < 20; i++ {
+				_ = v.Add(ownerTestUser(email, heldPassword))
+				_ = v.Del(email)
+			}
+			_ = v.Add(ownerTestUser(email, heldPassword))
+		}
+		wg.Add(4)
+		go churn("a@example.com")
+		go churn("A@example.com")
+		go churn("b@example.com")
+		go churn("c@example.com")
+		wg.Wait()
+		requireEveryHeldUserAuthenticatesAsItself(t, v)
+	}
+}
