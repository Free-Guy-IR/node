+package vmess
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/proxy/vmess/aead"
+)
+
+const (
+	heldID    = "6a3e0f5c-2b1d-4c8e-9f7a-1d2e3f4a5b6c"
+	variantID = "6a3e0f5c-2b1d-ffff-9f7a-1d2e3f4a5b6c"
+	ownID     = "0d9c8b7a-6f5e-4d3c-8b2a-1f0e9d8c7b6a"
+)
+
+func ownerTestUser(email, id string) *protocol.MemoryUser {
+	account, err := (&Account{Id: id}).AsAccount()
+	common.Must(err)
+	return &protocol.MemoryUser{Email: email, Account: account}
+}
+
+func authenticatesAs(v *TimedUserValidator, user *protocol.MemoryUser) *protocol.MemoryUser {
+	authID := aead.CreateAuthID(user.Account.(*MemoryAccount).ID.CmdKey(), time.Now().Unix())
+	got, _, err := v.GetAEAD(authID[:])
+	if err != nil {
+		return nil
+	}
+	return got
+}
+
+func emailOf(user *protocol.MemoryUser) string {
+	if user == nil {
+		return "nobody"
+	}
+	return user.Email
+}
+
+func requireEveryHeldUserAuthenticatesAsItself(t *testing.T, v *TimedUserValidator) {
+	t.Helper()
+	for _, user := range v.GetUsers() {
+		if got := authenticatesAs(v, user); got != user {
+			t.Fatalf("%s is held but its id authenticates as %s", user.Email, emailOf(got))
+		}
+	}
+}
+
+func TestAUserWhoseCredentialAnotherUserHoldsIsRefused(t *testing.T) {
+	v := NewTimedUserValidator()
+	a := ownerTestUser("a@example.com", heldID)
+	if err := v.Add(a); err != nil {
+		t.Fatal(err)
+	}
+
+	b := ownerTestUser("b@example.com", heldID)
+	if err := v.Add(b); err == nil {
+		t.Fatalf("b was added with the id a holds")
+	}
+	for _, user := range v.GetUsers() {
+		if user == b {
+			t.Fatalf("the refused b is still held")
+		}
+	}
+	if got := authenticatesAs(v, b); got != a {
+		t.Fatalf("the shared id authenticates as %s, want a", emailOf(got))
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+
+	if err := v.Add(ownerTestUser("b@example.com", variantID)); err != nil {
+		t.Fatalf("b could not be added with an id that differs from a's in bytes 6-7: %v", err)
+	}
+	if err := v.Add(ownerTestUser("c@example.com", ownID)); err != nil {
+		t.Fatalf("c could not be added with its own id: %v", err)
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+}
+
+func TestRemovingAUserLeavesACredentialAnotherUserHolds(t *testing.T) {
+	v := NewTimedUserValidator()
+	b := ownerTestUser("b@example.com", heldID)
+	if err := v.Add(b); err != nil {
+		t.Fatal(err)
+	}
+	a := ownerTestUser("a@example.com", heldID)
+	v.users = append(v.users, a)
+
+	if !v.Remove("a@example.com") {
+		t.Fatal("a was not found")
+	}
+	if got := authenticatesAs(v, b); got != b {
+		t.Fatalf("removing a left b's id authenticating as %s", emailOf(got))
+	}
+	for _, user := range v.GetUsers() {
+		if user == a {
+			t.Fatalf("a is still held after its removal")
+		}
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+}
+
+func TestAUserReaddedWithItsOwnCredentialKeepsIt(t *testing.T) {
+	v := NewTimedUserValidator()
+	if err := v.Add(ownerTestUser("a@example.com", heldID)); err != nil {
+		t.Fatal(err)
+	}
+	if !v.Remove("a@example.com") {
+		t.Fatal("a was not found")
+	}
+	again := ownerTestUser("A@example.com", heldID)
+	if err := v.Add(again); err != nil {
+		t.Fatalf("a could not be added again after its removal: %v", err)
+	}
+	if got := authenticatesAs(v, again); got != again {
+		t.Fatalf("the re-added a authenticates as %s", emailOf(got))
+	}
+	requireEveryHeldUserAuthenticatesAsItself(t, v)
+}
+
+func TestUsersWithoutAnEmailMayShareACredential(t *testing.T) {
+	v := NewTimedUserValidator()
+	first := ownerTestUser("", heldID)
+	second := ownerTestUser("", heldID)
+	if err := v.Add(first); err != nil {
+		t.Fatal(err)
+	}
+	if err := v.Add(second); err != nil {
+		t.Fatalf("a second user without an email was refused: %v", err)
+	}
+	if got := authenticatesAs(v, first); got != second {
+		t.Fatalf("the id authenticates as %p, want the last user added without an email", got)
+	}
+}
+
+func TestEveryHeldUserAuthenticatesAsItselfUnderChurn(t *testing.T) {
+	for round := 0; round < 200; round++ {
+		v := NewTimedUserValidator()
+		var wg sync.WaitGroup
+		churn := func(email, id string) {
+			defer wg.Done()
+			for i := 0; i < 20; i++ {
+				_ = v.Add(ownerTestUser(email, id))
+				v.Remove(email)
+			}
+			_ = v.Add(ownerTestUser(email, id))
+		}
+		wg.Add(4)
+		go churn("a@example.com", heldID)
+		go churn("b@example.com", heldID)
+		go churn("c@example.com", heldID)
+		go churn("d@example.com", variantID)
+		wg.Wait()
+		requireEveryHeldUserAuthenticatesAsItself(t, v)
+	}
+}
