+++ b/proxy/freedom/private_target_refusal_test.go
@@ -0,0 +1,431 @@
+package freedom
+
+import (
+	"context"
+	gonet "net"
+	"net/netip"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/pipe"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+var guardedInboundNames = []string{
+	"vless", "vmess", "trojan", "hysteria", "wireguard",
+	"shadowsocks", "shadowsocks-2022", "shadowsocks-2022-multi", "shadowsocks-2022-relay",
+}
+
+func privateHostAddress(t *testing.T) gonet.IP {
+	t.Helper()
+	ifaces, err := gonet.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, iface := range ifaces {
+		if iface.Flags&gonet.FlagUp == 0 || iface.Flags&gonet.FlagLoopback != 0 {
+			continue
+		}
+		addrs, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+		for _, addr := range addrs {
+			ipNet, ok := addr.(*gonet.IPNet)
+			if !ok || ipNet.IP.To4() == nil {
+				continue
+			}
+			if ip, ok := netip.AddrFromSlice(ipNet.IP.To4()); ok && ip.IsPrivate() {
+				return ipNet.IP.To4()
+			}
+		}
+	}
+	t.Skip("this host has no non-loopback private IPv4 address to listen on")
+	return nil
+}
+
+type privateListener struct {
+	port     net.Port
+	ip       gonet.IP
+	accepted atomic.Int32
+	received atomic.Int64
+}
+
+func listenOnPrivateHost(t *testing.T) *privateListener {
+	t.Helper()
+	ip := privateHostAddress(t)
+	ln, err := gonet.Listen("tcp4", gonet.JoinHostPort(ip.String(), "0"))
+	if err != nil {
+		t.Skipf("cannot listen on the private address %s: %v", ip, err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	l := &privateListener{port: net.Port(ln.Addr().(*gonet.TCPAddr).Port), ip: ip}
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			l.accepted.Add(1)
+			go func() {
+				defer conn.Close()
+				chunk := make([]byte, 1024)
+				for {
+					n, err := conn.Read(chunk)
+					l.received.Add(int64(n))
+					if err != nil {
+						return
+					}
+				}
+			}()
+		}
+	}()
+	return l
+}
+
+func (l *privateListener) destination() net.Destination {
+	return net.TCPDestination(net.IPAddress(l.ip), l.port)
+}
+
+func (l *privateListener) waitFor(received int64, within time.Duration) bool {
+	deadline := time.Now().Add(within)
+	for time.Now().Before(deadline) {
+		if l.received.Load() >= received {
+			return true
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	return l.received.Load() >= received
+}
+
+func processPayload(h *Handler, inbound *session.Inbound, target net.Destination, dialer internet.Dialer, payload []byte) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if inbound != nil {
+		ctx = session.ContextWithInbound(ctx, inbound)
+	}
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target}})
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	if len(payload) > 0 {
+		b := buf.New()
+		b.Write(payload)
+		uplinkWriter.WriteMultiBuffer(buf.MultiBuffer{b})
+	}
+	uplinkWriter.Close()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	return h.Process(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter}, dialer)
+}
+
+func newHandler(t *testing.T, config *Config) *Handler {
+	t.Helper()
+	h := new(Handler)
+	if err := h.Init(config, policy.DefaultManager{}); err != nil {
+		t.Fatal(err)
+	}
+	return h
+}
+
+type recordingDialer struct {
+	mu     sync.Mutex
+	dialed []net.Destination
+	dial   func(ctx context.Context, dest net.Destination) (stat.Connection, error)
+}
+
+func (d *recordingDialer) Dial(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+	d.mu.Lock()
+	d.dialed = append(d.dialed, dest)
+	d.mu.Unlock()
+	if d.dial != nil {
+		return d.dial(ctx, dest)
+	}
+	local, remote := gonet.Pipe()
+	remote.Close()
+	return local, nil
+}
+
+func (d *recordingDialer) DestIpAddress() net.IP {
+	return nil
+}
+
+func (d *recordingDialer) SetOutboundGateway(ctx context.Context, ob *session.Outbound) {}
+
+func (d *recordingDialer) count() int {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return len(d.dialed)
+}
