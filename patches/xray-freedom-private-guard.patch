+package conf_test
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	. "github.com/xtls/xray-core/infra/conf"
+	"github.com/xtls/xray-core/proxy/freedom"
+)
+
+func buildFreedom(t *testing.T, raw string) (*freedom.Config, error) {
+	t.Helper()
+	config := new(FreedomConfig)
+	if err := json.Unmarshal([]byte(raw), config); err != nil {
+		t.Fatal(err)
+	}
+	message, err := config.Build()
+	if err != nil {
+		return nil, err
+	}
+	return message.(*freedom.Config), nil
+}
+
+func TestFreedomReadsFinalRulesAndPrivateAllow(t *testing.T) {
+	config, err := buildFreedom(t, `{
+		"domainStrategy": "UseIPv4",
+		"finalRules": [
+			{"action": "Block", "network": "tcp", "port": "443", "ip": ["10.0.0.0/8"]},
+			{"action": "allow", "ip": ["192.168.0.0/16", "fd00::/8"]},
+			{"action": "ALLOW"}
+		],
+		"privateAllow": [
+			{"ruleTag": "PG_NODE_PRIVATE_ALLOW_1", "ip": ["100.64.0.0/10"]},
+			{"ruleTag": "lan", "ip": "10.8.0.0/16,10.9.0.1", "inboundTag": ["relay-in"], "network": "udp", "port": "53"}
+		]
+	}`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(config.FinalRules) != 3 || len(config.PrivateAllow) != 2 {
+		t.Fatalf("got %d finalRules and %d privateAllow entries, want 3 and 2", len(config.FinalRules), len(config.PrivateAllow))
+	}
+	first, second, third := config.FinalRules[0], config.FinalRules[1], config.FinalRules[2]
+	if !first.Block || second.Block || third.Block {
+		t.Errorf("actions block %v %v %v, want true false false", first.Block, second.Block, third.Block)
+	}
+	if len(first.Networks) != 1 || first.Networks[0] != net.Network_TCP || first.PortList == nil || len(first.PortList.Range) != 1 || first.PortList.Range[0].From != 443 {
+		t.Errorf("the first rule's network %v and ports %v", first.Networks, first.PortList)
+	}
+	if len(first.Ip) != 1 || len(first.Ip[0].Cidr) != 1 || first.Ip[0].Cidr[0].Prefix != 8 {
+		t.Errorf("the first rule's addresses %v", first.Ip)
+	}
+	if len(third.Ip) != 0 || third.Networks != nil || third.PortList != nil {
+		t.Errorf("an allow without conditions carries %v %v %v", third.Ip, third.Networks, third.PortList)
+	}
+	lan := config.PrivateAllow[1]
+	if config.PrivateAllow[0].RuleTag != "PG_NODE_PRIVATE_ALLOW_1" || lan.RuleTag != "lan" {
+		t.Errorf("privateAllow rule tags %q %q", config.PrivateAllow[0].RuleTag, lan.RuleTag)
+	}
+	if len(lan.InboundTags) != 0 || lan.Networks != nil || lan.PortList != nil || lan.Block {
+		t.Errorf("a privateAllow entry carries conditions of its own: %v", lan)
+	}
+	cidrs := 0
+	for _, geoip := range lan.Ip {
+		cidrs += len(geoip.Cidr)
+	}
+	if cidrs != 2 {
+		t.Errorf("the lan privateAllow entry holds %d prefixes, want 2", cidrs)
+	}
+}
+
+func TestFreedomRefusesMalformedPrivateTargetRules(t *testing.T) {
+	for _, raw := range []string{
+		`{"finalRules": [{"action": "reject", "ip": ["10.0.0.0/8"]}]}`,
+		`{"finalRules": [{"ip": ["10.0.0.0/8"]}]}`,
+		`{"finalRules": [null]}`,
+		`{"finalRules": [{"action": "allow", "ip": ["10.0.0.0/33"]}]}`,
+		`{"privateAllow": [{}]}`,
+		`{"privateAllow": [{"ruleTag": "lan", "ip": []}]}`,
+		`{"privateAllow": [{"ip": ["10.0.0.0/8"]}]}`,
+		`{"privateAllow": [null]}`,
+		`{"privateAllow": [{"ruleTag": "lan", "ip": ["not-an-address"]}]}`,
+	} {
+		if _, err := buildFreedom(t, raw); err == nil {
+			t.Errorf("%s was accepted", raw)
+		}
+	}
+	if _, err := buildFreedom(t, `{"finalRules": [], "privateAllow": []}`); err != nil {
+		t.Errorf("empty lists were refused: %v", err)
+	}
+}
