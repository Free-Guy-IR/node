diff --git a/infra/conf/freedom_private_target.go b/infra/conf/freedom_private_target.go
new file mode 100644
index 0000000..f22e93f
--- /dev/null
+++ b/infra/conf/freedom_private_target.go
@@ -0,0 +1,71 @@
+package conf
+
+import (
+	"strings"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/proxy/freedom"
+)
+
+type FreedomFinalRule struct {
+	Action  string       `json:"action"`
+	Network *NetworkList `json:"network"`
+	Port    *PortList    `json:"port"`
+	IP      *StringList  `json:"ip"`
+}
+
+type FreedomPrivateAllow struct {
+	RuleTag string      `json:"ruleTag"`
+	IP      *StringList `json:"ip"`
+}
+
+func (c *FreedomConfig) buildPrivateTargetRules(config *freedom.Config) error {
+	for _, entry := range c.FinalRules {
+		if entry == nil {
+			return errors.New("a finalRules entry is empty")
+		}
+		rule := &freedom.PrivateTargetRule{}
+		switch strings.ToLower(entry.Action) {
+		case "allow":
+		case "block":
+			rule.Block = true
+		default:
+			return errors.New("unknown finalRules action: ", entry.Action)
+		}
+		if err := fillPrivateTargetRule(rule, entry.Network, entry.Port, entry.IP); err != nil {
+			return errors.New("invalid finalRules entry").Base(err)
+		}
+		config.FinalRules = append(config.FinalRules, rule)
+	}
+	for _, entry := range c.PrivateAllow {
+		if entry == nil || entry.IP == nil || len(*entry.IP) == 0 {
+			return errors.New("a privateAllow entry needs an ip list")
+		}
+		if entry.RuleTag == "" {
+			return errors.New("a privateAllow entry needs the ruleTag of the routing rule that sends its ip list to this outbound")
+		}
+		rule := &freedom.PrivateTargetRule{RuleTag: entry.RuleTag}
+		if err := fillPrivateTargetRule(rule, nil, nil, entry.IP); err != nil {
+			return errors.New("invalid privateAllow entry").Base(err)
+		}
+		config.PrivateAllow = append(config.PrivateAllow, rule)
+	}
+	return nil
+}
+
+func fillPrivateTargetRule(rule *freedom.PrivateTargetRule, network *NetworkList, port *PortList, ip *StringList) error {
+	if network != nil {
+		rule.Networks = network.Build()
+	}
+	if port != nil {
+		rule.PortList = port.Build()
+	}
+	if ip != nil && len(*ip) > 0 {
+		geoips, err := ToCidrList(*ip)
+		if err != nil {
+			return err
+		}
+		rule.Ip = geoips
+	}
+	return nil
+}
