+	route.Networks = []net.Network{net.Network_TCP}
+	ctx, handler, freedom := realFreedomOutboundWith(t, "DIRECT", &Config{PrivateAllow: []*PrivateTargetRule{allowEntry("lan-tcp", hostCIDR(addr.IP))}}, &proxyman.SenderConfig{})
+	freedom.router = routerOf(t, route)
