+func (l *privateListener) waitFor(received int64, within time.Duration) bool {
+	deadline := time.Now().Add(within)
+	for time.Now().Before(deadline) {
+		if l.received.Load() >= received {
+			return true
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	return l.received.Load() >= received
+}
