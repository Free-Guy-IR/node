@@ -0,0 +1,63 @@
+package freedom
+
+import (
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+)
+
+func TestTheConnectCheckJudgesTheExactAddressTheSocketConnectsTo(t *testing.T) {
+	h := handlerRoutedBy(t, routerOf(t, routingRule("cgnat", "DIRECT", nil, "100.64.0.0/10")), allowEntry("cgnat", "100.64.0.0/10"))
+	users := &session.Inbound{Name: "vless", Tag: "users"}
+	ctx := sessionContext(users, net.TCPDestination(net.DomainAddress("target.pgtest"), 80), "DIRECT")
+	for address, want := range map[string]string{
+		"10.0.0.1:80":           "private",
+		"[fe80::1%lo0]:80":      "private",
+		"[fe80::1%2]:80":        "private",
+		"[fd00::1%eth0]:80":     "private",
+		"[::ffff:10.0.0.1]:80":  "private",
+		"127.0.0.1:80":          "local host",
+		"[::1]:80":              "local host",
+		"[::1%lo0]:80":          "local host",
+		"0.0.0.0:80":            "local host",
+		"[::]:80":               "local host",
+		"[::ffff:127.0.0.1]:80": "local host",
+		"100.64.0.1:80":         "",
+		"[2001:db8::1]:80":      "",
+		"target.pgtest:80":      "unparsable",
+		":80":                   "unparsable",
+		"10.0.0.1":              "unparsable",
+		"":                      "unparsable",
+	} {
+		refusal := &connectRefusal{}
+		err := h.connectCheck(ctx, users, refusal)("tcp", address)
+		target, kind := refusal.result()
+		if kind != want || (err != nil) != (want != "") || (target != nil) != (want != "") {
+			t.Errorf("the connect check on %q: %v, recorded %v %q; want %q", address, err, target, kind, want)
+		}
+	}
+	for network, want := range map[string]net.Network{"tcp4": net.Network_TCP, "tcp6": net.Network_TCP, "udp": net.Network_UDP, "udp4": net.Network_UDP, "udp6": net.Network_UDP} {
+		refusal := &connectRefusal{}
+		h.connectCheck(ctx, users, refusal)(network, "10.0.0.1:53")
+		if target, kind := refusal.result(); target == nil || target.Network != want || kind != "private" {
+			t.Errorf("the connect check on a %s connect recorded %v %q, want a refused %v destination", network, target, kind, want)
+		}
+	}
+	for _, network := range []string{"", "unix", "ip4"} {
+		refusal := &connectRefusal{}
+		if err := h.connectCheck(ctx, users, refusal)(network, "100.64.0.1:53"); err == nil {
+			t.Errorf("the connect check allowed a %q connect, whose kind it cannot judge", network)
+		}
+		if _, kind := refusal.result(); kind != "unparsable" {
+			t.Errorf("the connect check on a %q connect recorded %q, want unparsable", network, kind)
+		}
+	}
+	refusal := &connectRefusal{}
+	check := h.connectCheck(ctx, users, refusal)
+	check("tcp", "10.0.0.1:80")
+	check("tcp", "127.0.0.1:80")
+	if target, kind := refusal.result(); kind != "private" || target.Address.String() != "10.0.0.1" {
+		t.Errorf("the first refusal of a dial is the one reported, got %v %q", target, kind)
+	}
+}
