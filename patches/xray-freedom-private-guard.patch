+	spellings := []string{itoa(decimal), "0x" + hex2(v4[0]) + hex2(v4[1]) + hex2(v4[2]) + hex2(v4[3]), "0" + dotted, dotted + ".", "::ffff:" + dotted, "[::ffff:" + dotted + "]"}
