+package outbound_test
+
+import (
+	"context"
+	gonet "net"
+	"testing"
+
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/app/proxyman"
+	. "github.com/xtls/xray-core/app/proxyman/outbound"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	core "github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/proxy/freedom"
+	"github.com/xtls/xray-core/transport/internet"
+	_ "github.com/xtls/xray-core/transport/internet/tcp"
+	"github.com/xtls/xray-core/transport/internet/websocket"
+)
+
+func freedomHandler(t *testing.T, sender *proxyman.SenderConfig) *Handler {
+	t.Helper()
+	v, err := core.New(&core.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	v.AddFeature((outbound.Manager)(new(Manager)))
+	ctx := context.WithValue(context.Background(), xrayKey, v)
+	h, err := NewHandler(ctx, &core.OutboundHandlerConfig{Tag: "DIRECT", SenderSettings: serial.ToTypedMessage(sender), ProxySettings: serial.ToTypedMessage(&freedom.Config{})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return h.(*Handler)
+}
+
+type resolvingSystemDialer struct{}
+
+func (resolvingSystemDialer) Dial(ctx context.Context, src net.Address, dest net.Destination, sockopt *internet.SocketConfig) (gonet.Conn, error) {
+	var d gonet.Dialer
+	return d.DialContext(ctx, dest.Network.SystemString(), dest.NetAddr())
+}
+
+func (resolvingSystemDialer) DestIpAddress() net.IP {
+	return nil
+}
+
+func TestAnOutboundAppliesTheConnectCheckOnlyWhenEverySocketGoesThroughTheDefaultSystemDialer(t *testing.T) {
+	name := net.DomainAddress("example.pgtest")
+	tcp, udp := net.TCPDestination(name, 443), net.UDPDestination(name, 443)
+	magic := net.TCPDestination(net.DomainAddress(uot.MagicAddress), 0)
+	legacy := net.TCPDestination(net.DomainAddress(uot.LegacyMagicAddress), 0)
+	chain := &internet.StreamConfig{SocketSettings: &internet.SocketConfig{DialerProxy: "chain"}}
+	for _, c := range []struct {
+		name   string
+		sender *proxyman.SenderConfig
+		want   map[net.Destination]bool
+	}{
+		{"a plain freedom", &proxyman.SenderConfig{}, map[net.Destination]bool{tcp: true, udp: true, magic: true, legacy: true}},
+		{"a freedom bound to an interface", &proxyman.SenderConfig{StreamSettings: &internet.StreamConfig{SocketSettings: &internet.SocketConfig{Interface: "pgtun0"}}}, map[net.Destination]bool{tcp: true, udp: true}},
+		{"a freedom behind a dialerProxy chain", &proxyman.SenderConfig{StreamSettings: chain}, map[net.Destination]bool{tcp: false, udp: false, magic: true, legacy: true}},
+		{"a freedom behind proxySettings", &proxyman.SenderConfig{ProxySettings: &internet.ProxyConfig{Tag: "chain"}}, map[net.Destination]bool{tcp: false, udp: false, magic: false, legacy: false}},
+		{"a freedom over a websocket transport", &proxyman.SenderConfig{StreamSettings: &internet.StreamConfig{ProtocolName: "websocket", TransportSettings: []*internet.TransportConfig{{ProtocolName: "websocket", Settings: serial.ToTypedMessage(&websocket.Config{})}}}}, map[net.Destination]bool{tcp: false, udp: true}},
+	} {
+		h := freedomHandler(t, c.sender)
+		for dest, want := range c.want {
+			if got := h.AppliesConnectCheck(dest); got != want {
+				t.Errorf("%s to %v applies the connect check: %v, want %v", c.name, dest, got, want)
+			}
+		}
+	}
+	internet.UseAlternativeSystemDialer(resolvingSystemDialer{})
+	defer internet.UseAlternativeSystemDialer(nil)
+	h := freedomHandler(t, &proxyman.SenderConfig{})
+	for dest, want := range map[net.Destination]bool{tcp: false, udp: false, magic: true} {
+		if got := h.AppliesConnectCheck(dest); got != want {
+			t.Errorf("a plain freedom over an alternative system dialer to %v applies the connect check: %v, want %v", dest, got, want)
+		}
+	}
+}
