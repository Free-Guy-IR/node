+package router
+
+import (
+	"github.com/xtls/xray-core/features/routing"
+)
+
+func (r *Router) MatchingRule(ctx routing.Context) (string, string, bool) {
+	rule, _, err := r.pickRouteInternal(ctx)
+	if err != nil || rule == nil {
+		return "", "", false
+	}
+	return rule.RuleTag, rule.Tag, true
+}
