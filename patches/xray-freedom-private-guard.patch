+	netip.MustParsePrefix("fc00::/7"),
+	netip.MustParsePrefix("fe80::/10"),
+	netip.MustParsePrefix("ff00::/8"),
+}
+
+func isPrivateTarget(addr net.Address) bool {
+	if addr == nil || !addr.Family().IsIP() {
+		return false
+	}
+	ip, ok := netip.AddrFromSlice(addr.IP())
+	return ok && isPrivateIP(ip.Unmap())
+}
+
+func isPrivateIP(ip netip.Addr) bool {
+	for _, prefix := range privateTargetPrefixes {
+		if prefix.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+type targetRule struct {
+	block       bool
+	networks    []net.Network
+	ports       net.MemoryPortList
+	ip          router.GeoIPMatcher
+	inboundTags []string
+	ruleTag     string
+}
+
+func buildTargetRules(configs []*PrivateTargetRule) ([]*targetRule, error) {
+	rules := make([]*targetRule, 0, len(configs))
+	for _, config := range configs {
+		rule := &targetRule{
+			block:       config.GetBlock(),
+			networks:    config.GetNetworks(),
+			inboundTags: config.GetInboundTags(),
+			ruleTag:     config.GetRuleTag(),
+		}
+		if config.GetPortList() != nil {
+			rule.ports = net.PortListFromProto(config.GetPortList())
+		}
+		if len(config.GetIp()) > 0 {
+			matcher, err := router.BuildOptimizedGeoIPMatcher(config.GetIp()...)
+			if err != nil {
+				return nil, err
+			}
+			rule.ip = matcher
+		}
+		rules = append(rules, rule)
+	}
+	return rules, nil
+}
+
+func (h *Handler) initWithFeatures(config *Config) func(policy.Manager, routing.Router) error {
+	return func(pm policy.Manager, r routing.Router) error {
+		h.router, _ = r.(privateRuleMatcher)
+		return h.Init(config, pm)
+	}
+}
+
+func (h *Handler) initTargetRules(config *Config) error {
+	var err error
+	if h.finalRules, err = buildTargetRules(config.GetFinalRules()); err != nil {
+		return errors.New("failed to build the finalRules of freedom").Base(err)
+	}
+	if h.privateAllow, err = buildTargetRules(config.GetPrivateAllow()); err != nil {
+		return errors.New("failed to build the privateAllow of freedom").Base(err)
+	}
+	return nil
+}
+
+func (r *targetRule) matches(inbound *session.Inbound, dest net.Destination) bool {
+	if len(r.networks) > 0 && !slices.Contains(r.networks, dest.Network) {
+		return false
+	}
+	if len(r.ports) > 0 && !r.ports.Contains(dest.Port) {
+		return false
+	}
+	if len(r.inboundTags) > 0 && (inbound == nil || !slices.Contains(r.inboundTags, inbound.Tag)) {
+		return false
+	}
+	return r.ip == nil || r.ip.Match(dest.Address.IP())
+}
+
+func (h *Handler) refusesPrivateTarget(ctx context.Context, inbound *session.Inbound, dest net.Destination) bool {
+	if !refusesLocalHost(inbound) || !isPrivateTarget(dest.Address) {
+		return false
+	}
+	for _, rule := range h.finalRules {
+		if rule.matches(inbound, dest) {
+			return rule.block
+		}
+	}
+	return !h.routedHereByAnAllowingRule(ctx, dest)
+}
+
+func (h *Handler) routedHereByAnAllowingRule(ctx context.Context, dest net.Destination) bool {
+	if h.router == nil {
+		return false
+	}
+	var tags []string
+	for _, rule := range h.privateAllow {
+		if rule.ruleTag != "" && rule.matches(nil, dest) {
+			tags = append(tags, rule.ruleTag)
+		}
+	}
+	outbounds := session.OutboundsFromContext(ctx)
+	if len(tags) == 0 || len(outbounds) == 0 {
+		return false
+	}
+	own := outbounds[len(outbounds)-1]
+	ruleTag, outboundTag, matched := h.router.MatchingRule(privateRoutingContext(ctx, outbounds, dest))
+	return matched && outboundTag == own.Tag && slices.Contains(tags, ruleTag)
+}
+
+func privateRoutingContext(ctx context.Context, outbounds []*session.Outbound, dest net.Destination) routing.Context {
+	routed := slices.Clone(outbounds)
+	target := *routed[len(routed)-1]
+	target.Target = dest
+	target.RouteTarget = net.Destination{}
+	routed[len(routed)-1] = &target
+	return routing_session.AsRoutingContext(session.ContextWithOutbounds(ctx, routed))
+}
+
+func remoteTarget(conn net.Conn) (net.Destination, bool) {
+	switch addr := conn.RemoteAddr().(type) {
+	case *net.TCPAddr:
+		return net.TCPDestination(net.IPAddress(addr.IP), net.Port(addr.Port)), len(addr.IP) > 0 && !addr.IP.IsUnspecified()
+	case *net.UDPAddr:
+		return net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port)), len(addr.IP) > 0 && !addr.IP.IsUnspecified()
+	}
+	return net.Destination{}, false
+}
+
+type connectCheckedDialer interface {
+	AppliesConnectCheck(dest net.Destination) bool
+}
+
+func appliesConnectCheck(dialer internet.Dialer, dest net.Destination) bool {
+	checked, ok := dialer.(connectCheckedDialer)
+	return ok && checked.AppliesConnectCheck(dest)
+}
+
+type connectRefusal struct {
+	mu     sync.Mutex
+	target *net.Destination
+	kind   string
+}
+
+func (r *connectRefusal) refuse(target net.Destination, kind string) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.target == nil {
+		r.target, r.kind = &target, kind
+	}
+	return errors.New("refused to connect to the ", kind, " address ", target)
+}
+
+func (r *connectRefusal) result() (*net.Destination, string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.target, r.kind
+}
+
+func connectNetwork(name string) (net.Network, bool) {
+	switch {
+	case strings.HasPrefix(name, "tcp"):
+		return net.Network_TCP, true
+	case strings.HasPrefix(name, "udp"):
+		return net.Network_UDP, true
+	}
+	return net.Network_Unknown, false
+}
+
+func connectTarget(network net.Network, address string) (net.Destination, netip.Addr, bool) {
+	parsed, err := netip.ParseAddrPort(address)
+	if err != nil {
+		return net.Destination{}, netip.Addr{}, false
+	}
+	ip := parsed.Addr().WithZone("").Unmap()
+	return net.Destination{Network: network, Address: net.IPAddress(ip.AsSlice()), Port: net.Port(parsed.Port())}, ip, true
+}
+
+func (h *Handler) refusedKind(ctx context.Context, inbound *session.Inbound, target net.Destination, ip netip.Addr) string {
+	if ip.IsLoopback() || ip.IsUnspecified() {
+		return "local host"
+	}
+	if isPrivateIP(ip) && h.refusesPrivateTarget(ctx, inbound, target) {
+		return "private"
+	}
+	return ""
+}
+
+func (h *Handler) connectCheck(ctx context.Context, inbound *session.Inbound, refusal *connectRefusal) internet.ConnectCheck {
+	return func(networkName, address string) error {
+		network, known := connectNetwork(networkName)
+		target, ip, ok := connectTarget(network, address)
+		if !known || !ok {
+			return refusal.refuse(net.Destination{Network: network, Address: net.DomainAddress(networkName + " " + address)}, "unparsable")
+		}
+		if kind := h.refusedKind(ctx, inbound, target, ip); kind != "" {
+			return refusal.refuse(target, kind)
+		}
+		return nil
+	}
+}
+
+func (h *Handler) resolveOnce(ctx context.Context, inbound *session.Inbound, dest net.Destination) ([]net.Destination, *net.Destination, string, error) {
+	addrs, err := net.DefaultResolver.LookupIPAddr(ctx, dest.Address.Domain())
+	if err != nil {
+		return nil, nil, "", errors.New("cannot resolve ", dest.Address.Domain(), " to check it, so it is not dialed").Base(err)
+	}
+	if len(addrs) == 0 {
+		return nil, nil, "", errors.New(dest.Address.Domain(), " resolves to no address, so it is not dialed")
+	}
+	checked := make([]net.Destination, 0, len(addrs))
+	for _, addr := range addrs {
+		ip, ok := netip.AddrFromSlice(addr.IP)
+		if !ok {
+			unparsable := net.Destination{Network: dest.Network, Address: net.DomainAddress(addr.String()), Port: dest.Port}
+			return nil, &unparsable, "unparsable", nil
+		}
+		ip = ip.Unmap()
+		target := net.Destination{Network: dest.Network, Address: net.IPAddress(ip.AsSlice()), Port: dest.Port}
+		if kind := h.refusedKind(ctx, inbound, target, ip); kind != "" {
+			return nil, &target, kind, nil
+		}
+		checked = append(checked, target)
+	}
+	return checked, nil, "", nil
+}
+
+func (h *Handler) answerRefusal(ctx context.Context, inbound *session.Inbound, dest net.Destination) func(net.Address) bool {
+	if !refusesLocalHost(inbound) {
+		return nil
+	}
+	return func(addr net.Address) bool {
+		answer := net.Destination{Network: dest.Network, Address: addr, Port: dest.Port}
+		return isLocalHostAddress(addr) || h.refusesPrivateTarget(ctx, inbound, answer)
+	}
+}
+
+func (w *PacketWriter) answerRefusal(port net.Port) func(net.Address) bool {
+	return func(addr net.Address) bool {
+		return w.RefuseLocalHost && isLocalHostAddress(addr) || w.RefusesTarget != nil && w.RefusesTarget(net.UDPDestination(addr, port))
+	}
+}
+
+func pickAnswer(ips []net.IP, refused func(net.Address) bool) net.Address {
+	dialable := make([]net.Address, 0, len(ips))
+	for _, ip := range ips {
+		if addr := net.IPAddress(ip); addr != nil && (refused == nil || !refused(addr)) {
+			dialable = append(dialable, addr)
+		}
+	}
+	if len(dialable) == 0 {
+		return net.IPAddress(ips[dice.Roll(len(ips))])
+	}
+	return dialable[dice.Roll(len(dialable))]
+}
+
+func dialFirst(ctx context.Context, dialer internet.Dialer, candidates []net.Destination) (stat.Connection, error) {
+	var err error
+	for _, candidate := range candidates {
+		var conn stat.Connection
+		if conn, err = dialer.Dial(ctx, candidate); err == nil {
+			return conn, nil
+		}
+	}
+	return nil, err
+}
