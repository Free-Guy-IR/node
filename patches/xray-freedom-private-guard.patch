+func (d *recordingDialer) Dial(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+	d.mu.Lock()
+	d.dialed = append(d.dialed, dest)
+	d.mu.Unlock()
+	if d.dial != nil {
+		return d.dial(ctx, dest)
+	}
+	local, remote := gonet.Pipe()
+	remote.Close()
+	return local, nil
+}
