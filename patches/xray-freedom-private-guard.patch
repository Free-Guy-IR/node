+func TestFinalRulesDecideAPrivateTargetByTheirFirstMatch(t *testing.T) {
+	inbound := &session.Inbound{Name: "vless", Tag: "users"}
+	target := net.TCPDestination(net.IPAddress([]byte{10, 1, 2, 3}), 443)
+	for _, c := range []struct {
+		name    string
+		rules   []*PrivateTargetRule
+		refused bool
+	}{
+		{"no rule", nil, true},
+		{"allow", []*PrivateTargetRule{cidrRule(false, "10.0.0.0/8")}, false},
+		{"block then allow", []*PrivateTargetRule{cidrRule(true, "10.1.2.3/32"), cidrRule(false, "10.0.0.0/8")}, true},
+		{"allow then block", []*PrivateTargetRule{cidrRule(false, "10.1.2.3/32"), cidrRule(true, "10.0.0.0/8")}, false},
+		{"allow of another range", []*PrivateTargetRule{cidrRule(false, "192.168.0.0/16")}, true},
+		{"allow without an address list", []*PrivateTargetRule{{}}, false},
+		{"allow on another network", []*PrivateTargetRule{{Networks: []net.Network{net.Network_UDP}}}, true},
+		{"allow on another port", []*PrivateTargetRule{{PortList: &net.PortList{Range: []*net.PortRange{{From: 80, To: 80}}}}}, true},
+		{"allow on the port", []*PrivateTargetRule{{PortList: &net.PortList{Range: []*net.PortRange{{From: 400, To: 500}}}}}, false},
+	} {
+		h := newHandler(t, &Config{FinalRules: c.rules})
+		if got := h.refusesPrivateTarget(inbound, target); got != c.refused {
+			t.Errorf("%s: %s refused %v, want %v", c.name, target, got, c.refused)
+		}
+	}
+	h := newHandler(t, &Config{FinalRules: []*PrivateTargetRule{cidrRule(true, "1.1.1.1/32"), {Block: true}}})
+	if h.refusesPrivateTarget(inbound, net.TCPDestination(net.IPAddress([]byte{1, 1, 1, 1}), 443)) {
+		t.Error("finalRules refused a public target")
+	}
+	if h.refusesPrivateTarget(&session.Inbound{Name: "socks"}, target) {
+		t.Error("finalRules refused a private target of a socks inbound")
+	}
+}
