@@ -0,0 +1,127 @@
+package freedom
+
+import (
+	"context"
+	"encoding/binary"
+	gonet "net"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/app/proxyman"
+	proxyoutbound "github.com/xtls/xray-core/app/proxyman/outbound"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/transport"
+	_ "github.com/xtls/xray-core/transport/internet/tcp"
+	_ "github.com/xtls/xray-core/transport/internet/udp"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+func realFreedomOutbound(t *testing.T, tag string, config *Config) (context.Context, outbound.Handler) {
+	t.Helper()
+	ctx, handler, _ := realFreedomOutboundWith(t, tag, config, &proxyman.SenderConfig{})
+	return ctx, handler
+}
+
+func realFreedomOutboundWith(t *testing.T, tag string, config *Config, sender *proxyman.SenderConfig) (context.Context, outbound.Handler, *Handler) {
+	t.Helper()
+	instance, err := core.New(&core.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := instance.AddFeature((outbound.Manager)(new(proxyoutbound.Manager))); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
+	handler, err := proxyoutbound.NewHandler(ctx, &core.OutboundHandlerConfig{Tag: tag, SenderSettings: serial.ToTypedMessage(sender), ProxySettings: serial.ToTypedMessage(config)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ctx, handler, handler.(*proxyoutbound.Handler).GetOutbound().(*Handler)
+}
+
+func dispatchThrough(ctx context.Context, handler outbound.Handler, inbound *session.Inbound, target net.Destination, uplink ...[]byte) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	ctx = session.ContextWithInbound(ctx, inbound)
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target, Tag: handler.Tag()}})
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	for _, chunk := range uplink {
+		b := buf.New()
+		b.Write(chunk)
+		uplinkWriter.WriteMultiBuffer(buf.MultiBuffer{b})
+	}
+	go func() {
+		time.Sleep(time.Second)
+		uplinkWriter.Close()
+	}()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	handler.Dispatch(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter})
+}
+
+func TestARebindingNameThroughARealFreedomOutboundNeverReachesThePrivateListener(t *testing.T) {
+	listener := listenOnPrivateHost(t)
+	dns := &scriptedDNS{decide: publicThenPrivate(listener.ip)}
+	serveScriptedDNS(t, dns, "rebind-real.pgtest")
+	ctx, handler := realFreedomOutbound(t, "DIRECT", &Config{})
+	dispatchThrough(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.DomainAddress("rebind-real.pgtest"), listener.port), []byte("payload"))
+	requireUntouched(t, "a rebinding name through a real freedom outbound (DNS "+dns.answers()+")", listener, nil)
+}
+
+func uotConnectFrame(t *testing.T, to *gonet.UDPAddr, payload []byte) []byte {
+	t.Helper()
+	request, err := uot.EncodeRequest(uot.Request{IsConnect: true, Destination: M.SocksaddrFromNet(to)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer request.Release()
+	frame := append([]byte(nil), request.Bytes()...)
+	frame = binary.BigEndian.AppendUint16(frame, uint16(len(payload)))
+	return append(frame, payload...)
+}
+
+func TestUDPOverTCPThroughARealFreedomOutboundNeverReachesAPrivateListener(t *testing.T) {
+	serveScriptedDNS(t, &scriptedDNS{decide: nowhere})
+	ctx, handler := realFreedomOutbound(t, "DIRECT", &Config{})
+	for _, magic := range []string{uot.MagicAddress, uot.LegacyMagicAddress} {
+		target, addr := listenUDPOnPrivateHost(t)
+		frame := uotConnectFrame(t, addr, []byte("datagram"))
+		if magic == uot.LegacyMagicAddress {
+			destination := M.SocksaddrFromNet(addr)
+			legacy := buf.New()
+			if err := uot.AddrParser.WriteAddrPort(legacy, destination); err != nil {
+				t.Fatal(err)
+			}
+			frame = binary.BigEndian.AppendUint16(append([]byte(nil), legacy.Bytes()...), uint16(len("datagram")))
+			frame = append(frame, "datagram"...)
+			legacy.Release()
+		}
+		dispatchThrough(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.DomainAddress(magic), 0), frame)
+		if receivedDatagram(target, 500*time.Millisecond) {
+			t.Errorf("a vless UDP-over-TCP request to %s delivered a datagram to the private listener %s", magic, addr)
+		}
+	}
+}
+
+func TestUDPOverTCPToAnAllowedPrivateDestinationStillCarriesTheDatagram(t *testing.T) {
+	serveScriptedDNS(t, &scriptedDNS{decide: nowhere})
+	target, addr := listenUDPOnPrivateHost(t)
+	ctx, handler := realFreedomOutbound(t, "DIRECT", &Config{FinalRules: []*PrivateTargetRule{cidrRule(false, hostCIDR(addr.IP))}})
+	dispatchThrough(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.DomainAddress(uot.MagicAddress), 0), uotConnectFrame(t, addr, []byte("datagram")))
+	if !receivedDatagram(target, time.Second) {
+		t.Errorf("a vless UDP-over-TCP request to %s allowed by finalRules delivered nothing", addr)
+	}
+}
