+func receivedDatagram(conn gonet.PacketConn, within time.Duration) bool {
+	conn.SetReadDeadline(time.Now().Add(within))
+	packet := make([]byte, 64)
+	n, _, err := conn.ReadFrom(packet)
+	return err == nil && n > 0
+}
