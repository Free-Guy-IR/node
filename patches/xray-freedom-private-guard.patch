diff --git a/proxy/freedom/private_target.go b/proxy/freedom/private_target.go
new file mode 100644
index 0000000..236fb25
--- /dev/null
+++ b/proxy/freedom/private_target.go
@@ -0,0 +1,154 @@
+package freedom
+
+import (
+	"context"
+	"net/netip"
+	"slices"
+
+	"github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+)
+
+func v4Prefix(a, b, c, d byte, bits int) netip.Prefix {
+	return netip.PrefixFrom(netip.AddrFrom4([4]byte{a, b, c, d}), bits)
+}
+
+var privateTargetPrefixes = []netip.Prefix{
+	v4Prefix(0, 0, 0, 0, 8),
+	v4Prefix(10, 0, 0, 0, 8),
+	v4Prefix(100, 64, 0, 0, 10),
+	v4Prefix(127, 0, 0, 0, 8),
+	v4Prefix(169, 254, 0, 0, 16),
+	v4Prefix(172, 16, 0, 0, 12),
+	v4Prefix(192, 0, 0, 0, 24),
+	v4Prefix(192, 0, 2, 0, 24),
+	v4Prefix(192, 88, 99, 0, 24),
+	v4Prefix(192, 168, 0, 0, 16),
+	v4Prefix(198, 18, 0, 0, 15),
+	v4Prefix(198, 51, 100, 0, 24),
+	v4Prefix(203, 0, 113, 0, 24),
+	v4Prefix(224, 0, 0, 0, 3),
+	netip.MustParsePrefix("::/127"),
+	netip.MustParsePrefix("fc00::/7"),
+	netip.MustParsePrefix("fe80::/10"),
+	netip.MustParsePrefix("ff00::/8"),
+}
+
+func isPrivateTarget(addr net.Address) bool {
+	if addr == nil || !addr.Family().IsIP() {
+		return false
+	}
+	ip, ok := netip.AddrFromSlice(addr.IP())
+	if !ok {
+		return false
+	}
+	ip = ip.Unmap()
+	for _, prefix := range privateTargetPrefixes {
+		if prefix.Contains(ip) {
+			return true
+		}
+	}
+	return false
+}
+
+type targetRule struct {
+	block       bool
+	networks    []net.Network
+	ports       net.MemoryPortList
+	ip          router.GeoIPMatcher
+	inboundTags []string
+}
+
+func buildTargetRules(configs []*PrivateTargetRule) ([]*targetRule, error) {
+	rules := make([]*targetRule, 0, len(configs))
+	for _, config := range configs {
+		rule := &targetRule{
+			block:       config.GetBlock(),
+			networks:    config.GetNetworks(),
+			inboundTags: config.GetInboundTags(),
+		}
+		if config.GetPortList() != nil {
+			rule.ports = net.PortListFromProto(config.GetPortList())
+		}
+		if len(config.GetIp()) > 0 {
+			matcher, err := router.BuildOptimizedGeoIPMatcher(config.GetIp()...)
+			if err != nil {
+				return nil, err
+			}
+			rule.ip = matcher
+		}
+		rules = append(rules, rule)
+	}
+	return rules, nil
+}
+
+func (h *Handler) initTargetRules(config *Config) error {
+	var err error
+	if h.finalRules, err = buildTargetRules(config.GetFinalRules()); err != nil {
+		return errors.New("failed to build the finalRules of freedom").Base(err)
+	}
+	if h.privateAllow, err = buildTargetRules(config.GetPrivateAllow()); err != nil {
+		return errors.New("failed to build the privateAllow of freedom").Base(err)
+	}
+	return nil
+}
+
+func (r *targetRule) matches(inbound *session.Inbound, dest net.Destination) bool {
+	if len(r.networks) > 0 && !slices.Contains(r.networks, dest.Network) {
+		return false
+	}
+	if len(r.ports) > 0 && !r.ports.Contains(dest.Port) {
+		return false
+	}
+	if len(r.inboundTags) > 0 && (inbound == nil || !slices.Contains(r.inboundTags, inbound.Tag)) {
+		return false
+	}
+	return r.ip == nil || r.ip.Match(dest.Address.IP())
+}
+
+func (h *Handler) refusesPrivateTarget(inbound *session.Inbound, dest net.Destination) bool {
+	if !refusesLocalHost(inbound) || !isPrivateTarget(dest.Address) {
+		return false
+	}
+	for _, rule := range h.finalRules {
+		if rule.matches(inbound, dest) {
+			return rule.block
+		}
+	}
+	for _, rule := range h.privateAllow {
+		if rule.matches(inbound, dest) {
+			return false
+		}
+	}
+	return true
+}
+
+func (h *Handler) refusedResolvedTarget(ctx context.Context, inbound *session.Inbound, dest net.Destination) (*net.Destination, string) {
+	addrs, err := net.DefaultResolver.LookupIPAddr(ctx, dest.Address.Domain())
+	if err != nil {
+		errors.LogInfoInner(ctx, err, "failed to resolve ", dest.Address.Domain(), " before dialing it")
+		return nil, ""
+	}
+	for _, addr := range addrs {
+		resolved := net.Destination{Network: dest.Network, Address: net.IPAddress(addr.IP), Port: dest.Port}
+		if isLocalHostAddress(resolved.Address) {
+			return &resolved, "local host"
+		}
+		if h.refusesPrivateTarget(inbound, resolved) {
+			return &resolved, "private"
+		}
+	}
+	return nil, ""
+}
+
+func remoteTarget(conn net.Conn) (net.Destination, bool) {
+	switch addr := conn.RemoteAddr().(type) {
+	case *net.TCPAddr:
+		return net.TCPDestination(net.IPAddress(addr.IP), net.Port(addr.Port)), len(addr.IP) > 0 && !addr.IP.IsUnspecified()
+	case *net.UDPAddr:
+		return net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port)), len(addr.IP) > 0 && !addr.IP.IsUnspecified()
+	}
+	return net.Destination{}, false
+}
