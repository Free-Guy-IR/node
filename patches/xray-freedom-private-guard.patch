+func TestAnAllowCarriesDataToThePrivateListener(t *testing.T) {
+	for _, name := range []string{"finalRules", "privateAllow", "block first"} {
+		listener := listenOnPrivateHost(t)
+		h := newHandler(t, &Config{})
+		switch name {
+		case "finalRules":
+			h = newHandler(t, &Config{FinalRules: []*PrivateTargetRule{cidrRule(false, hostCIDR(listener.ip))}})
+		case "privateAllow":
+			h = handlerRoutedBy(t, routerOf(t, routingRule("lan-host", "DIRECT", nil, hostCIDR(listener.ip))), allowEntry("lan-host", hostCIDR(listener.ip)))
+		case "block first":
+			h = newHandler(t, &Config{FinalRules: []*PrivateTargetRule{cidrRule(true, hostCIDR(listener.ip)), cidrRule(false, hostCIDR(listener.ip))}})
+		}
+		err := processPayloadThrough(h, &session.Inbound{Name: "vless", Tag: "users"}, listener.destination(), "DIRECT", systemDialer{}, []byte("payload"))
+		if name == "block first" {
+			time.Sleep(100 * time.Millisecond)
+			if !refusedAsPrivate(err, "vless") || listener.accepted.Load() != 0 {
+				t.Errorf("%s: %v, the listener accepted %d connections, want a refusal", name, err, listener.accepted.Load())
+			}
+			continue
+		}
+		if refusedAsPrivate(err, "vless") || !listener.waitFor(int64(len("payload")), 2*time.Second) {
+			t.Errorf("%s: %v, the listener received %d bytes, want the payload", name, err, listener.received.Load())
+		}
+	}
+}
