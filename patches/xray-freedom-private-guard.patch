+	if accepted := listener.accepted.Load(); accepted != 10 || refusals != 0 {
+		t.Errorf("a ForceIPv4 freedom resolving a name to %s three times and to the allowed %s once: %d of 10 connections reached the allowed address and %d were refused for the random pick, want 10 and 0", refused, listener.ip, accepted, refusals)
+	}
+}
+
+func TestARealFreedomOutboundBehindADialerProxyNeverHandsTheChainTheName(t *testing.T) {
+	listener := listenOnPrivateHost(t)
+	serveScriptedDNS(t, &scriptedDNS{decide: always(listener.ip)}, "chained-real.pgtest")
+	ctx, handler, _ := realFreedomOutboundWith(t, "DIRECT", &Config{}, &proxyman.SenderConfig{StreamSettings: &internet.StreamConfig{SocketSettings: &internet.SocketConfig{DialerProxy: "chain"}}})
+	chain := useChain(t, nil)
+	dispatchThrough(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.DomainAddress("chained-real.pgtest"), listener.port), []byte("payload"))
+	requireUntouched(t, "a private name through a real freedom outbound behind dialerProxy, the chain was handed "+chain.targets(), listener, nil)
+	if handed := chain.targets(); handed != "" {
+		t.Errorf("the chain behind a real freedom outbound was handed %s for a name of a private address", handed)
+	}
+}
+
+func TestAForceIPFreedomResolvesADatagramsNameOnlyToAnAddressItWouldSendTo(t *testing.T) {
+	target, addr := listenUDPOnPrivateHost(t)
+	refused := net.IP{192, 0, 2, 1}
+	ctx, handler, _ := realFreedomOutboundWith(t, "DIRECT", &Config{DomainStrategy: internet.DomainStrategy_USE_IP4, FinalRules: []*PrivateTargetRule{cidrRule(false, hostCIDR(addr.IP))}}, &proxyman.SenderConfig{})
+	internet.InitSystemDialer(&stubDNSClient{answers: map[string][]net.IP{"mixed-udp.pgtest": {refused, refused, refused, addr.IP}}}, nil)
+	t.Cleanup(func() { internet.InitSystemDialer(nil, nil) })
+	listener := net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port))
+	byName := net.UDPDestination(net.DomainAddress("mixed-udp.pgtest"), net.Port(addr.Port))
+	delivered := 0
+	for range 6 {
+		sendDatagramsOnAFlowTo(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, listener, byName, false, 1)
+		delivered += datagramsReceived(target, 300*time.Millisecond)
+	}
+	if delivered != 6 {
+		t.Errorf("six UDP flows sent a datagram to a name a UseIPv4 freedom resolves to %s three times and to the allowed %s once: %d delivered, want 6", refused, addr.IP, delivered)
+	}
+}
+
+func TestAnXUDPFlowOutlivesTheContextThatOpenedIt(t *testing.T) {
+	target, addr := listenUDPOnPrivateHost(t)
+	allowed := net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port))
+	base, handler, _ := realFreedomOutboundWith(t, "DIRECT", &Config{FinalRules: []*PrivateTargetRule{cidrRule(false, hostCIDR(addr.IP))}}, &proxyman.SenderConfig{})
+	opener, closeOpener := context.WithCancel(base)
+	defer closeOpener()
+	ctx := session.ContextWithInbound(opener, &session.Inbound{Name: "vless", Tag: "users"})
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: allowed, Tag: handler.Tag()}})
+	ctx = session.ContextWithTimeoutOnly(ctx, true)
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	done := make(chan struct{})
+	go func() {
+		handler.Dispatch(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter})
+		close(done)
+	}()
+	send := func() {
+		b := buf.New()
+		b.WriteString("datagram")
+		dest := allowed
+		b.UDP = &dest
+		uplinkWriter.WriteMultiBuffer(buf.MultiBuffer{b})
+	}
+	send()
+	before := datagramsReceived(target, 500*time.Millisecond)
+	closeOpener()
+	time.Sleep(300 * time.Millisecond)
+	send()
+	after := datagramsReceived(target, 500*time.Millisecond)
+	uplinkWriter.Close()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Error("the XUDP flow did not end after its uplink closed")
+	}
+	if before != 1 || after != 1 {
+		t.Errorf("an XUDP flow delivered %d datagram before and %d after the context that opened it ended, want 1 and 1: freedom detaches it so that it outlives that context", before, after)
+	}
+}
