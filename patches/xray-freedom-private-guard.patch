+	}
+	return nil
+}
+func (m *chainManager) GetDefaultHandler() outbound.Handler                      { return m.handler }
+func (m *chainManager) AddHandler(ctx context.Context, h outbound.Handler) error { return nil }
+func (m *chainManager) RemoveHandler(ctx context.Context, tag string) error      { return nil }
+func (m *chainManager) ListHandlers(ctx context.Context) []outbound.Handler {
+	return []outbound.Handler{m.handler}
+}
