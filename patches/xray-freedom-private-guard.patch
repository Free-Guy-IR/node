+package internet
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+type ConnectCheck func(network, address string) error
+
+type connectCheckKey struct{}
+
+func ContextWithConnectCheck(ctx context.Context, check ConnectCheck) context.Context {
+	return context.WithValue(ctx, connectCheckKey{}, check)
+}
+
+func ConnectCheckFromContext(ctx context.Context) ConnectCheck {
+	check, _ := ctx.Value(connectCheckKey{}).(ConnectCheck)
+	return check
+}
+
+func SystemDialerAppliesConnectChecks() bool {
+	_, ok := effectiveSystemDialer.(*DefaultSystemDialer)
+	return ok
+}
+
+type checkedPacketConn struct {
+	net.PacketConn
+	check ConnectCheck
+}
+
+func CheckedPacketConn(conn net.PacketConn, check ConnectCheck) net.PacketConn {
+	return &checkedPacketConn{PacketConn: conn, check: check}
+}
+
+func (c *checkedPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	if addr == nil || c.check(addr.Network(), addr.String()) != nil {
+		return len(p), nil
+	}
+	return c.PacketConn.WriteTo(p, addr)
+}
diff --git a/transport/internet/connect_check_test.go b/transport/internet/connect_check_test.go
new file mode 100644
index 0000000..706ce67
--- /dev/null
+++ b/transport/internet/connect_check_test.go
@@ -0,0 +1,234 @@
+package internet_test
+
+import (
+	"context"
+	"errors"
+	gonet "net"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	. "github.com/xtls/xray-core/transport/internet"
+)
+
+type connectChecks struct {
+	mu      sync.Mutex
+	seen    []string
+	refuses bool
+}
+
+var errRefusedByTheCheck = errors.New("refused by the connect check")
+
+func (c *connectChecks) check(network, address string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.seen = append(c.seen, network+" "+address)
+	if c.refuses {
+		return errRefusedByTheCheck
+	}
+	return nil
+}
+
+func (c *connectChecks) addresses() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return slices.Clone(c.seen)
+}
+
+func countingListener(t *testing.T) (net.Port, *atomic.Int32) {
+	t.Helper()
+	ln, err := gonet.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	accepted := new(atomic.Int32)
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			accepted.Add(1)
+			conn.Close()
+		}
+	}()
+	return net.Port(ln.Addr().(*gonet.TCPAddr).Port), accepted
+}
+
+func TestTheSystemDialerRunsTheConnectCheckBeforeEveryTCPConnect(t *testing.T) {
+	port, accepted := countingListener(t)
+	for _, sockopt := range []*SocketConfig{nil, {TcpKeepAliveIdle: 30}} {
+		checks := &connectChecks{refuses: true}
+		conn, err := DialSystem(ContextWithConnectCheck(context.Background(), checks.check), net.TCPDestination(net.LocalHostIP, port), sockopt)
+		if err == nil {
+			conn.Close()
+		}
+		time.Sleep(100 * time.Millisecond)
+		if !errors.Is(err, errRefusedByTheCheck) || accepted.Load() != 0 {
+			t.Errorf("sockopt %v: a refusing connect check gave %v and the listener accepted %d connections, want the check's error and no handshake", sockopt, err, accepted.Load())
+		}
+		if want := []string{"tcp4 127.0.0.1:" + port.String()}; !slices.Equal(checks.addresses(), want) {
+			t.Errorf("sockopt %v: the check saw %v, want %v", sockopt, checks.addresses(), want)
+		}
+	}
+	checks := &connectChecks{}
+	conn, err := DialSystem(ContextWithConnectCheck(context.Background(), checks.check), net.TCPDestination(net.LocalHostIP, port), nil)
+	if err != nil {
+		t.Fatalf("a connect check that allows the address: %v", err)
+	}
+	conn.Close()
+	if len(checks.addresses()) != 1 {
+		t.Errorf("an allowed connect was checked %d times, want once", len(checks.addresses()))
+	}
+}
+
+func TestTheConnectCheckSeesTheAddressAResolvedNameConnectsTo(t *testing.T) {
+	port, accepted := countingListener(t)
+	checks := &connectChecks{refuses: true}
+	_, err := DialSystem(ContextWithConnectCheck(context.Background(), checks.check), net.TCPDestination(net.DomainAddress("localhost"), port), nil)
+	time.Sleep(100 * time.Millisecond)
+	if !errors.Is(err, errRefusedByTheCheck) || accepted.Load() != 0 {
+		t.Errorf("localhost through a refusing connect check: %v, %d accepted", err, accepted.Load())
+	}
+	seen := checks.addresses()
+	if len(seen) == 0 {
+		t.Fatal("the connect check never ran for a name")
+	}
+	for _, entry := range seen {
+		if entry != "tcp4 127.0.0.1:"+port.String() && entry != "tcp6 [::1]:"+port.String() {
+			t.Errorf("the connect check saw %q, want the resolved loopback address and port", entry)
+		}
+	}
+}
+
+type answeringDNS struct {
+	answers map[string][]net.IP
+}
+
+func (d *answeringDNS) Type() interface{} { return dns.ClientType() }
+func (d *answeringDNS) Start() error      { return nil }
+func (d *answeringDNS) Close() error      { return nil }
+func (d *answeringDNS) LookupIP(domain string, option dns.IPOption) ([]net.IP, uint32, error) {
+	if ips, ok := d.answers[domain]; ok {
+		return ips, 0, nil
+	}
+	return nil, 0, dns.ErrEmptyResponse
+}
+
+func TestEveryRacedConnectAndEveryResolvedRetargetIsChecked(t *testing.T) {
+	port, accepted := countingListener(t)
+	InitSystemDialer(&answeringDNS{answers: map[string][]net.IP{"raced.pgtest": {net.LocalHostIP.IP(), {127, 0, 0, 1}}, "retarget.pgtest": {net.LocalHostIP.IP()}}}, nil)
+	t.Cleanup(func() { InitSystemDialer(nil, nil) })
+	for _, c := range []struct {
+		name    string
+		sockopt *SocketConfig
+		want    int
+	}{
+		{"retarget.pgtest", &SocketConfig{DomainStrategy: DomainStrategy_USE_IP4}, 1},
+		{"raced.pgtest", &SocketConfig{DomainStrategy: DomainStrategy_USE_IP4, HappyEyeballs: &HappyEyeballsConfig{TryDelayMs: 20, MaxConcurrentTry: 4, Interleave: 1}}, 2},
+	} {
+		checks := &connectChecks{refuses: true}
+		_, err := DialSystem(ContextWithConnectCheck(context.Background(), checks.check), net.TCPDestination(net.DomainAddress(c.name), port), c.sockopt)
+		time.Sleep(100 * time.Millisecond)
+		if err == nil || accepted.Load() != 0 {
+			t.Errorf("%s through a refusing connect check: %v, %d accepted", c.name, err, accepted.Load())
+		}
+		if got := len(checks.addresses()); got != c.want {
+			t.Errorf("%s: the connect check ran %d times (%v), want %d", c.name, got, checks.addresses(), c.want)
+		}
+	}
+}
+
+func TestTheSystemDialerChecksTheResolvedUDPDestination(t *testing.T) {
+	listener, err := gonet.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	port := net.Port(listener.LocalAddr().(*gonet.UDPAddr).Port)
+	checks := &connectChecks{refuses: true}
+	conn, err := DialSystem(ContextWithConnectCheck(context.Background(), checks.check), net.UDPDestination(net.DomainAddress("localhost"), port), nil)
+	if err == nil {
+		conn.Write([]byte("datagram"))
+		conn.Close()
+	}
+	if !errors.Is(err, errRefusedByTheCheck) {
+		t.Errorf("a UDP name through a refusing connect check: %v, want the check's error", err)
+	}
+	listener.SetReadDeadline(time.Now().Add(300 * time.Millisecond))
+	if n, _, err := listener.ReadFrom(make([]byte, 64)); err == nil {
+		t.Errorf("the refused UDP destination received %d bytes", n)
+	}
+	for _, entry := range checks.addresses() {
+		if entry != "udp 127.0.0.1:"+port.String() && entry != "udp [::1]:"+port.String() {
+			t.Errorf("the UDP check saw %q, want the resolved loopback address and port", entry)
+		}
+	}
+}
+
+func TestACheckedPacketConnDropsOnlyTheRefusedDatagrams(t *testing.T) {
+	refused, err := gonet.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer refused.Close()
+	allowed, err := gonet.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer allowed.Close()
+	inner, err := gonet.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer inner.Close()
+	conn := CheckedPacketConn(inner, func(network, address string) error {
+		if address == refused.LocalAddr().String() {
+			return errRefusedByTheCheck
+		}
+		return nil
+	})
+	for _, to := range []gonet.Addr{refused.LocalAddr(), allowed.LocalAddr()} {
+		if n, err := conn.WriteTo([]byte("datagram"), to); n != len("datagram") || err != nil {
+			t.Errorf("WriteTo %v: %d, %v; a dropped datagram must look written so the flow goes on", to, n, err)
+		}
+	}
+	for listener, want := range map[gonet.PacketConn]bool{refused: false, allowed: true} {
+		listener.SetReadDeadline(time.Now().Add(300 * time.Millisecond))
+		_, _, err := listener.ReadFrom(make([]byte, 64))
+		if got := err == nil; got != want {
+			t.Errorf("%v received a datagram: %v, want %v", listener.LocalAddr(), got, want)
+		}
+	}
+}
+
+type plainSystemDialer struct{}
+
+func (plainSystemDialer) Dial(ctx context.Context, src net.Address, dest net.Destination, sockopt *SocketConfig) (gonet.Conn, error) {
+	var d gonet.Dialer
+	return d.DialContext(ctx, dest.Network.SystemString(), dest.NetAddr())
+}
+
+func (plainSystemDialer) DestIpAddress() net.IP {
+	return nil
+}
+
+func TestOnlyTheDefaultSystemDialerAppliesConnectChecks(t *testing.T) {
+	if !SystemDialerAppliesConnectChecks() {
+		t.Fatal("the default system dialer does not report that it applies connect checks")
+	}
+	UseAlternativeSystemDialer(plainSystemDialer{})
+	alternative := SystemDialerAppliesConnectChecks()
+	UseAlternativeSystemDialer(nil)
+	if alternative {
+		t.Error("an alternative system dialer reports that it applies connect checks")
+	}
+	if !SystemDialerAppliesConnectChecks() {
+		t.Error("restoring the default system dialer did not restore the connect checks")
+	}
+}
