+func TestACGNATAllowCarriesDataThroughFreedomAndStopsThere(t *testing.T) {
+	local, err := gonet.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	received := make(chan string, 4)
+	go func() {
+		for {
+			conn, err := local.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer conn.Close()
+				chunk := make([]byte, 64)
+				if n, _ := conn.Read(chunk); n > 0 {
+					received <- string(chunk[:n])
+				}
+			}()
+		}
+	}()
+	cgnat := gonet.IPv4(100, 64, 0, 7).To4()
+	dialer := &recordingDialer{dial: func(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+		conn, err := gonet.Dial("tcp4", local.Addr().String())
+		if err != nil {
+			return nil, err
+		}
+		return &reportedRemote{Conn: conn, remote: &gonet.TCPAddr{IP: dest.Address.IP(), Port: int(dest.Port)}}, nil
+	}}
+	h := newHandler(t, &Config{PrivateAllow: []*PrivateTargetRule{cidrRule(false, "100.64.0.0/10")}})
+	err = processPayload(h, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.IPAddress(cgnat), 9000), dialer, []byte("cgnat"))
+	if refusedAsPrivate(err, "vless") {
+		t.Fatalf("vless to the CGNAT address was refused: %v", err)
+	}
+	select {
+	case got := <-received:
+		if got != "cgnat" {
+			t.Fatalf("the CGNAT target received %q", got)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("the CGNAT target received nothing")
+	}
+	for _, other := range [][]byte{{10, 0, 0, 7}, {172, 16, 0, 7}, {192, 168, 0, 7}, {169, 254, 169, 254}} {
+		before := dialer.count()
+		err := processPayload(h, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.IPAddress(other), 9000), dialer, []byte("leak"))
+		if !refusedAsPrivate(err, "vless") || dialer.count() != before {
+			t.Errorf("the CGNAT allow let vless reach %v: %v", gonet.IP(other), err)
+		}
+	}
+	dialer.dial = func(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+		conn, err := gonet.Dial("tcp4", local.Addr().String())
+		if err != nil {
+			return nil, err
+		}
+		return &reportedRemote{Conn: conn, remote: &gonet.TCPAddr{IP: gonet.IPv4(10, 0, 0, 7), Port: 9000}}, nil
+	}
+	err = processPayload(h, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(net.DomainAddress("cgnat-or-not.pgtest"), 9000), dialer, []byte("rebound"))
+	if !refusedAsPrivate(err, "vless") {
+		t.Errorf("a connection whose remote end is outside the CGNAT allow was kept: %v", err)
+	}
+	select {
+	case got := <-received:
+		t.Errorf("a connection whose remote end is outside the CGNAT allow delivered %q", got)
+	case <-time.After(300 * time.Millisecond):
+	}
+}
