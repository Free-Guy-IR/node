+	dispatchThrough(ctx, handler, users, net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port)), []byte("datagram"))
+	if receivedDatagram(target, 700*time.Millisecond) {
+		t.Fatalf("plain UDP to %s was delivered although rule lan-tcp covers tcp only", addr)
+	}
+	dispatchThrough(ctx, handler, users, net.TCPDestination(net.DomainAddress(uot.MagicAddress), 0), uotConnectFrame(t, addr, []byte("datagram")))
+	if receivedDatagram(target, time.Second) {
+		t.Errorf("a UDP-over-TCP datagram reached %s through a privateAllow whose routing rule covers tcp only", addr)
+	}
+}
+
+func TestAForceIPFreedomPicksOnlyAmongTheAnswersItWouldDial(t *testing.T) {
