+func TestThePrivateSetIsTheShippedGeoIPPrivateList(t *testing.T) {
+	path := os.Getenv("XRAY_FREEDOM_GEOIP_DAT")
+	if path == "" {
+		t.Skip("XRAY_FREEDOM_GEOIP_DAT names no geoip.dat to compare with")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list router.GeoIPList
+	if err := proto.Unmarshal(raw, &list); err != nil {
+		t.Fatal(err)
+	}
+	var shipped []netip.Prefix
+	for _, entry := range list.Entry {
+		if !strings.EqualFold(entry.CountryCode, "private") {
+			continue
+		}
+		for _, cidr := range entry.Cidr {
+			addr, ok := netip.AddrFromSlice(cidr.Ip)
+			if !ok {
+				t.Fatalf("geoip:private holds an invalid address %v", cidr.Ip)
+			}
+			shipped = append(shipped, netip.PrefixFrom(addr.Unmap(), int(cidr.Prefix)).Masked())
+		}
+	}
+	builtIn := slices.Clone(privateTargetPrefixes)
+	order := func(a, b netip.Prefix) int {
+		if c := a.Addr().Compare(b.Addr()); c != 0 {
+			return c
+		}
+		return a.Bits() - b.Bits()
+	}
+	slices.SortFunc(shipped, order)
+	slices.SortFunc(builtIn, order)
+	if !slices.Equal(shipped, builtIn) {
+		t.Fatalf("geoip:private of %s is %v, the built-in private set is %v", path, shipped, builtIn)
+	}
+}
+
+func cidrRule(block bool, cidrs ...string) *PrivateTargetRule {
+	geoip := &router.GeoIP{}
+	for _, c := range cidrs {
+		prefix := netip.MustParsePrefix(c).Masked()
+		geoip.Cidr = append(geoip.Cidr, &router.CIDR{Ip: prefix.Addr().AsSlice(), Prefix: uint32(prefix.Bits())})
+	}
+	return &PrivateTargetRule{Block: block, Ip: []*router.GeoIP{geoip}}
+}
+
+func hostCIDR(ip gonet.IP) string {
+	return netip.PrefixFrom(netip.AddrFrom4([4]byte(ip.To4())), 32).String()
+}
