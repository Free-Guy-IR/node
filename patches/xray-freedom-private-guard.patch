+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/pipe"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+var guardedInboundNames = []string{
+	"vless", "vmess", "trojan", "hysteria", "wireguard",
+	"shadowsocks", "shadowsocks-2022", "shadowsocks-2022-multi", "shadowsocks-2022-relay",
+}
+
+func privateHostAddress(t *testing.T) gonet.IP {
+	t.Helper()
+	ifaces, err := gonet.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, iface := range ifaces {
+		if iface.Flags&gonet.FlagUp == 0 || iface.Flags&gonet.FlagLoopback != 0 {
+			continue
+		}
+		addrs, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+		for _, addr := range addrs {
+			ipNet, ok := addr.(*gonet.IPNet)
+			if !ok || ipNet.IP.To4() == nil {
+				continue
+			}
+			if ip, ok := netip.AddrFromSlice(ipNet.IP.To4()); ok && ip.IsPrivate() {
+				return ipNet.IP.To4()
+			}
+		}
+	}
+	t.Skip("this host has no non-loopback private IPv4 address to listen on")
+	return nil
+}
+
+type privateListener struct {
+	port     net.Port
+	ip       gonet.IP
+	accepted atomic.Int32
+	received atomic.Int64
+}
+
+func listenOnPrivateHost(t *testing.T) *privateListener {
+	t.Helper()
+	ip := privateHostAddress(t)
+	ln, err := gonet.Listen("tcp4", gonet.JoinHostPort(ip.String(), "0"))
+	if err != nil {
+		t.Skipf("cannot listen on the private address %s: %v", ip, err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	l := &privateListener{port: net.Port(ln.Addr().(*gonet.TCPAddr).Port), ip: ip}
+	go func() {
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			l.accepted.Add(1)
+			go func() {
+				defer conn.Close()
+				chunk := make([]byte, 1024)
+				for {
+					n, err := conn.Read(chunk)
+					l.received.Add(int64(n))
+					if err != nil {
+						return
+					}
+				}
+			}()
+		}
+	}()
+	return l
+}
+
+func (l *privateListener) destination() net.Destination {
+	return net.TCPDestination(net.IPAddress(l.ip), l.port)
+}
+
+func (l *privateListener) waitFor(received int64, within time.Duration) bool {
+	deadline := time.Now().Add(within)
+	for time.Now().Before(deadline) {
+		if l.received.Load() >= received {
+			return true
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	return l.received.Load() >= received
+}
+
+func processPayload(h *Handler, inbound *session.Inbound, target net.Destination, dialer internet.Dialer, payload []byte) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if inbound != nil {
+		ctx = session.ContextWithInbound(ctx, inbound)
+	}
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target}})
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	if len(payload) > 0 {
+		b := buf.New()
+		b.Write(payload)
+		uplinkWriter.WriteMultiBuffer(buf.MultiBuffer{b})
+	}
+	uplinkWriter.Close()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	return h.Process(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter}, dialer)
+}
+
+func newHandler(t *testing.T, config *Config) *Handler {
+	t.Helper()
+	h := new(Handler)
+	if err := h.Init(config, policy.DefaultManager{}); err != nil {
+		t.Fatal(err)
+	}
+	return h
+}
+
+type recordingDialer struct {
+	mu     sync.Mutex
+	dialed []net.Destination
+	dial   func(ctx context.Context, dest net.Destination) (stat.Connection, error)
+}
+
+func (d *recordingDialer) Dial(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+	d.mu.Lock()
+	d.dialed = append(d.dialed, dest)
+	d.mu.Unlock()
+	if d.dial != nil {
+		return d.dial(ctx, dest)
+	}
+	local, remote := gonet.Pipe()
+	remote.Close()
+	return local, nil
+}
+
+func (d *recordingDialer) DestIpAddress() net.IP {
+	return nil
+}
+
+func (d *recordingDialer) SetOutboundGateway(ctx context.Context, ob *session.Outbound) {}
+
+func (d *recordingDialer) count() int {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return len(d.dialed)
+}
+
+func refusedAsPrivate(err error, inbound string) bool {
+	return err != nil && strings.Contains(err.Error(), "private address") && strings.Contains(err.Error(), "the "+inbound+" inbound")
+}
+
+func TestAUserInboundCannotReachAPrivateListenerThroughFreedom(t *testing.T) {
+	for _, name := range guardedInboundNames {
+		listener := listenOnPrivateHost(t)
+		err := processPayload(newHandler(t, &Config{}), &session.Inbound{Name: name, Tag: "users"}, listener.destination(), systemDialer{}, []byte("payload"))
+		time.Sleep(100 * time.Millisecond)
+		if !refusedAsPrivate(err, name) {
+			t.Errorf("%s to %s: %v, want a refusal of the private address naming the inbound", name, listener.destination(), err)
+		}
+		if listener.accepted.Load() != 0 || listener.received.Load() != 0 {
+			t.Errorf("%s to %s: the private listener accepted %d connections and received %d bytes", name, listener.destination(), listener.accepted.Load(), listener.received.Load())
+		}
+	}
+}
+
+func TestAUserInboundIsRefusedEveryPrivateRangeBeforeTheDial(t *testing.T) {
+	targets := []net.Address{
+		net.IPAddress([]byte{10, 1, 2, 3}),
+		net.IPAddress([]byte{100, 64, 0, 1}),
+		net.IPAddress([]byte{169, 254, 169, 254}),
+		net.IPAddress([]byte{172, 16, 0, 1}),
+		net.IPAddress([]byte{192, 0, 0, 1}),
+		net.IPAddress([]byte{192, 0, 2, 1}),
+		net.IPAddress([]byte{192, 88, 99, 1}),
+		net.IPAddress([]byte{192, 168, 1, 1}),
+		net.IPAddress([]byte{198, 18, 0, 1}),
+		net.IPAddress([]byte{198, 51, 100, 1}),
+		net.IPAddress([]byte{203, 0, 113, 1}),
+		net.IPAddress([]byte{224, 0, 0, 251}),
+		net.IPAddress([]byte{240, 0, 0, 1}),
+		net.IPAddress([]byte{255, 255, 255, 255}),
+		net.ParseAddress("fd00::1"),
+		net.ParseAddress("fe80::1"),
+		net.ParseAddress("ff02::1"),
+	}
+	for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+		for _, address := range targets {
+			dialer := &recordingDialer{}
+			target := net.Destination{Network: network, Address: address, Port: 8080}
+			err := processPayload(newHandler(t, &Config{}), &session.Inbound{Name: "vless", Tag: "users"}, target, dialer, nil)
+			if !refusedAsPrivate(err, "vless") || dialer.count() != 0 {
+				t.Errorf("vless to %s: %v after %d dials, want a refusal before any dial", target, err, dialer.count())
+			}
+		}
+	}
+}
+
+type stubDNSClient struct {
+	answers map[string][]net.IP
+}
+
+func (s *stubDNSClient) Type() interface{} {
+	return dns.ClientType()
+}
+
+func (s *stubDNSClient) Start() error {
+	return nil
+}
+
+func (s *stubDNSClient) Close() error {
+	return nil
+}
+
+func (s *stubDNSClient) LookupIP(domain string, option dns.IPOption) ([]net.IP, uint32, error) {
+	if ips, ok := s.answers[domain]; ok {
+		return ips, 0, nil
+	}
+	return nil, 0, dns.ErrEmptyResponse
+}
+
+func TestANameFreedomResolvesToAPrivateAddressIsRefusedBeforeTheDial(t *testing.T) {
+	listener := listenOnPrivateHost(t)
+	internet.InitSystemDialer(&stubDNSClient{answers: map[string][]net.IP{"private-target.pgtest": {listener.ip}}}, nil)
+	t.Cleanup(func() { internet.InitSystemDialer(nil, nil) })
+
+	target := net.TCPDestination(net.DomainAddress("private-target.pgtest"), listener.port)
+	err := processPayload(newHandler(t, &Config{DomainStrategy: internet.DomainStrategy_USE_IP4}), &session.Inbound{Name: "vless", Tag: "users"}, target, systemDialer{}, []byte("payload"))
+	time.Sleep(100 * time.Millisecond)
+	if !refusedAsPrivate(err, "vless") {
+		t.Errorf("vless to %s: %v, want a refusal of the private address", target, err)
+	}
+	if listener.accepted.Load() != 0 {
+		t.Errorf("vless to %s: the private listener accepted %d connections", target, listener.accepted.Load())
+	}
+}
+
+func serveStubDNS(t *testing.T, name string, answer gonet.IP) string {
+	t.Helper()
+	conn, err := gonet.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	fqdn := name + "."
+	go func() {
+		packet := make([]byte, 1500)
+		for {
+			n, from, err := conn.ReadFrom(packet)
+			if err != nil {
+				return
+			}
+			var parser dnsmessage.Parser
+			header, err := parser.Start(packet[:n])
+			if err != nil {
+				continue
+			}
+			question, err := parser.Question()
+			if err != nil {
+				continue
+			}
+			rcode := dnsmessage.RCodeNameError
+			if strings.EqualFold(question.Name.String(), fqdn) {
+				rcode = dnsmessage.RCodeSuccess
+			}
+			builder := dnsmessage.NewBuilder(nil, dnsmessage.Header{ID: header.ID, Response: true, Authoritative: true, RCode: rcode})
+			builder.StartQuestions()
+			builder.Question(question)
+			builder.StartAnswers()
+			if rcode == dnsmessage.RCodeSuccess && question.Type == dnsmessage.TypeA {
+				var a [4]byte
+				copy(a[:], answer.To4())
+				builder.AResource(dnsmessage.ResourceHeader{Name: question.Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET}, dnsmessage.AResource{A: a})
+			}
+			reply, err := builder.Finish()
+			if err != nil {
+				continue
+			}
+			conn.WriteTo(reply, from)
+		}
+	}()
+	return conn.LocalAddr().String()
+}
+
+func useStubSystemResolver(t *testing.T, server string) {
+	t.Helper()
+	resolver := gonet.DefaultResolver
+	preferGo, dial := resolver.PreferGo, resolver.Dial
+	resolver.PreferGo = true
+	resolver.Dial = func(ctx context.Context, network, address string) (gonet.Conn, error) {
+		var d gonet.Dialer
+		return d.DialContext(ctx, "udp4", server)
+	}
+	t.Cleanup(func() {
