+++ b/proxy/freedom/private_target_paths_test.go
@@ -0,0 +1,389 @@
+package freedom
+
+import (
+	"context"
+	gonet "net"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/log"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+type linkLocalListener struct {
+	ip       gonet.IP
+	iface    gonet.Interface
+	port     net.Port
+	accepted atomic.Int32
+}
+
+func listenOnLinkLocal(t *testing.T) *linkLocalListener {
+	t.Helper()
+	ifaces, err := gonet.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	slices.SortStableFunc(ifaces, func(a, b gonet.Interface) int {
+		return int(b.Flags&gonet.FlagLoopback) - int(a.Flags&gonet.FlagLoopback)
+	})
+	for _, iface := range ifaces {
+		if iface.Flags&gonet.FlagUp == 0 {
+			continue
+		}
+		addrs, _ := iface.Addrs()
+		for _, addr := range addrs {
+			ipNet, ok := addr.(*gonet.IPNet)
+			if !ok || ipNet.IP.To4() != nil || !ipNet.IP.IsLinkLocalUnicast() {
+				continue
+			}
+			ln, err := gonet.Listen("tcp6", gonet.JoinHostPort(ipNet.IP.String()+"%"+iface.Name, "0"))
+			if err != nil {
+				continue
+			}
+			t.Cleanup(func() { ln.Close() })
+			l := &linkLocalListener{ip: ipNet.IP, iface: iface, port: net.Port(ln.Addr().(*gonet.TCPAddr).Port)}
+			go func() {
+				for {
+					conn, err := ln.Accept()
+					if err != nil {
+						return
+					}
+					l.accepted.Add(1)
+					conn.Close()
+				}
+			}()
+			return l
+		}
+	}
+	t.Skip("this host has no IPv6 link-local address to listen on")
+	return nil
+}
+
+func (l *linkLocalListener) zonedNames() []string {
+	byName := l.ip.String() + "%" + l.iface.Name
+	byIndex := l.ip.String() + "%" + itoa(l.iface.Index)
+	return []string{byName, byIndex, "[" + byName + "]", "[" + byIndex + "]"}
+}
+
+func redirectTo(address net.Address, port net.Port) *Config {
