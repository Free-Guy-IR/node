+type recordedLog struct {
+	mu       sync.Mutex
+	messages []*log.GeneralMessage
+}
+
+func (r *recordedLog) Handle(msg log.Message) {
+	if general, ok := msg.(*log.GeneralMessage); ok {
+		r.mu.Lock()
+		r.messages = append(r.messages, general)
+		r.mu.Unlock()
+	}
+}
+
+func (r *recordedLog) atLeast(severity log.Severity, text string) []string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var found []string
+	for _, msg := range r.messages {
+		if msg.Severity <= severity && strings.Contains(msg.String(), text) {
+			found = append(found, msg.String())
+		}
+	}
+	return found
+}
