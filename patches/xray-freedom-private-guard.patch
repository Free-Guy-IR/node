+type chainHandler struct {
+	mu      sync.Mutex
+	tag     string
+	answers map[string]gonet.IP
+	handed  []string
+}
+
+func (c *chainHandler) Start() error                         { return nil }
+func (c *chainHandler) Close() error                         { return nil }
+func (c *chainHandler) Tag() string                          { return c.tag }
+func (c *chainHandler) SenderSettings() *serial.TypedMessage { return nil }
+func (c *chainHandler) ProxySettings() *serial.TypedMessage  { return nil }
+
+func (c *chainHandler) targets() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return strings.Join(c.handed, ", ")
+}
+
+func (c *chainHandler) Dispatch(ctx context.Context, link *transport.Link) {
+	outbounds := session.OutboundsFromContext(ctx)
+	target := outbounds[len(outbounds)-1].Target
+	c.mu.Lock()
+	c.handed = append(c.handed, target.String())
+	c.mu.Unlock()
+	address := target.NetAddr()
+	if target.Address.Family().IsDomain() {
+		if ip, ok := c.answers[target.Address.Domain()]; ok {
+			address = gonet.JoinHostPort(ip.String(), target.Port.String())
+		} else if addrs, err := gonet.DefaultResolver.LookupIPAddr(context.Background(), target.Address.Domain()); err == nil && len(addrs) > 0 {
+			address = gonet.JoinHostPort(addrs[0].String(), target.Port.String())
+		}
+	}
+	conn, err := gonet.DialTimeout("tcp", address, boundedDial)
+	if err != nil {
+		common.Interrupt(link.Writer)
+		common.Interrupt(link.Reader)
+		return
+	}
+	defer conn.Close()
+	go buf.Copy(buf.NewReader(conn), link.Writer)
+	buf.Copy(link.Reader, buf.NewWriter(conn))
+}
