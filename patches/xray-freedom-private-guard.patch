+		allowEntry("shadowed", "10.1.0.0/16"),
+		allowEntry("cgnat", "100.64.0.0/10"),
+		allowEntry("relay-only", "172.16.0.0/12"),
+		allowEntry("documentation-and-public", "192.0.2.0/24"),
+		allowEntry("users-direct", "10.0.0.0/8", "192.168.0.0/16"),
+	)
+	egress := handlerRoutedBy(t, r, allowEntry("egress-lan", "192.168.0.0/16"))
+	for _, c := range []struct {
+		name     string
+		h        *Handler
+		outbound string
+		inbound  string
+		address  []byte
+		refused  bool
+	}{
+		{"an earlier block shadows the allowing rule", direct, "DIRECT", "users", []byte{10, 1, 2, 3}, true},
+		{"the CGNAT rule for one inbound", direct, "DIRECT", "users", []byte{100, 64, 0, 1}, false},
+		{"the CGNAT rule for another inbound", direct, "DIRECT", "relay-in", []byte{100, 127, 255, 254}, false},
+		{"an inbound-restricted rule for its inbound", direct, "DIRECT", "relay-in", []byte{172, 16, 0, 1}, false},
+		{"an inbound-restricted rule for another inbound", direct, "DIRECT", "users", []byte{172, 16, 0, 1}, true},
+		{"a rule for another outbound", direct, "DIRECT", "users", []byte{192, 168, 1, 1}, true},
+		{"that rule on its own outbound", egress, "egress", "users", []byte{192, 168, 1, 1}, false},
+		{"an allow of this outbound on a connection of another", direct, "egress", "users", []byte{100, 64, 0, 1}, true},
+		{"the explicit private part of a mixed rule", direct, "DIRECT", "users", []byte{192, 0, 2, 1}, false},
+		{"another private address the same mixed rule catches", direct, "DIRECT", "users", []byte{198, 51, 100, 1}, true},
+		{"a catch-all rule listed by mistake", direct, "DIRECT", "users", []byte{169, 254, 169, 254}, true},
+	} {
+		dest := net.TCPDestination(net.IPAddress(c.address), 443)
+		inbound := &session.Inbound{Name: "vless", Tag: c.inbound}
+		got := c.h.refusesPrivateTarget(sessionContext(inbound, dest, c.outbound), inbound, dest)
+		if got != c.refused {
+			t.Errorf("%s: %s from %s through %s refused %v, want %v", c.name, dest, c.inbound, c.outbound, got, c.refused)
+		}
+	}
+	unrouted := newHandler(t, &Config{PrivateAllow: []*PrivateTargetRule{allowEntry("cgnat", "100.64.0.0/10")}})
+	dest := net.TCPDestination(net.IPAddress([]byte{100, 64, 0, 1}), 443)
+	users := &session.Inbound{Name: "vless", Tag: "users"}
+	if !unrouted.refusesPrivateTarget(sessionContext(users, dest, "DIRECT"), users, dest) {
+		t.Error("a privateAllow entry opened a private target without a router to confirm the rule")
+	}
+}
+
+func processPayloadThrough(h *Handler, inbound *session.Inbound, target net.Destination, outboundTag string, dialer internet.Dialer, payload []byte) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	ctx = session.ContextWithInbound(ctx, inbound)
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target, Tag: outboundTag}})
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	if len(payload) > 0 {
+		b := buf.New()
+		b.Write(payload)
+		uplinkWriter.WriteMultiBuffer(buf.MultiBuffer{b})
+	}
+	uplinkWriter.Close()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	return h.Process(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter}, dialer)
+}
