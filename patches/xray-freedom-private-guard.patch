+func TestAnAllowNeverOpensTheLocalHost(t *testing.T) {
+	loopbackRouter := routerOf(t, routingRule("loopback", "DIRECT", nil, "127.0.0.1/8", "::1/128"))
+	for _, h := range []*Handler{
+		newHandler(t, &Config{FinalRules: []*PrivateTargetRule{cidrRule(false, "127.0.0.1/8", "::1/128")}}),
+		newHandler(t, &Config{FinalRules: []*PrivateTargetRule{{}}}),
+		handlerRoutedBy(t, loopbackRouter, allowEntry("loopback", "127.0.0.1/8", "::1/128")),
+	} {
+		for _, address := range []net.Address{net.LocalHostIP, net.LocalHostIPv6} {
+			dialer := &recordingDialer{}
+			err := processPayloadThrough(h, &session.Inbound{Name: "vless", Tag: "users"}, net.TCPDestination(address, 8080), "DIRECT", dialer, nil)
+			if err == nil || !strings.Contains(err.Error(), "local host address") || dialer.count() != 0 {
+				t.Errorf("to %s: %v after %d dials, want the local host refused", address, err, dialer.count())
+			}
+		}
+	}
+}
