+type chainManager struct {
+	handler *chainHandler
+}
+
+func (m *chainManager) Type() interface{} { return outbound.ManagerType() }
+func (m *chainManager) Start() error      { return nil }
+func (m *chainManager) Close() error      { return nil }
+func (m *chainManager) GetHandler(tag string) outbound.Handler {
