@@ -0,0 +1,74 @@
+package router_test
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	routing_session "github.com/xtls/xray-core/features/routing/session"
+)
+
+func TestMatchingRuleNamesTheFirstMatchWithoutFiringItsWebhook(t *testing.T) {
+	var hooks atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hooks.Add(1)
+	}))
+	defer server.Close()
+
+	r := new(router.Router)
+	config := &router.Config{Rule: []*router.RoutingRule{
+		{
+			TargetTag: &router.RoutingRule_Tag{Tag: "BLOCK"},
+			RuleTag:   "hooked",
+			Geoip:     []*router.GeoIP{{Cidr: []*router.CIDR{{Ip: []byte{10, 0, 0, 0}, Prefix: 8}}}},
+			Webhook:   &router.WebhookConfig{Url: server.URL},
+		},
+		{
+			TargetTag: &router.RoutingRule_Tag{Tag: "DIRECT"},
+			RuleTag:   "cgnat",
+			Geoip:     []*router.GeoIP{{Cidr: []*router.CIDR{{Ip: []byte{100, 64, 0, 0}, Prefix: 10}}}},
+		},
+	}}
+	if err := r.Init(context.Background(), config, nil, nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	routed := func(ip []byte) *routing_session.Context {
+		ctx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: net.TCPDestination(net.IPAddress(ip), 443)}})
+		return routing_session.AsRoutingContext(ctx).(*routing_session.Context)
+	}
+
+	for range 5 {
+		ruleTag, outboundTag, matched := r.MatchingRule(routed([]byte{10, 1, 2, 3}))
+		if !matched || ruleTag != "hooked" || outboundTag != "BLOCK" {
+			t.Fatalf("MatchingRule gave %q %q %v, want the hooked rule to BLOCK", ruleTag, outboundTag, matched)
+		}
+	}
+	if ruleTag, outboundTag, matched := r.MatchingRule(routed([]byte{100, 64, 0, 1})); !matched || ruleTag != "cgnat" || outboundTag != "DIRECT" {
+		t.Fatalf("MatchingRule gave %q %q %v, want the cgnat rule to DIRECT", ruleTag, outboundTag, matched)
+	}
+	if _, _, matched := r.MatchingRule(routed([]byte{1, 1, 1, 1})); matched {
+		t.Fatal("MatchingRule matched a target no rule covers")
+	}
+	time.Sleep(300 * time.Millisecond)
+	if n := hooks.Load(); n != 0 {
+		t.Fatalf("MatchingRule fired the rule's webhook %d times", n)
+	}
+
+	if _, err := r.PickRoute(routed([]byte{10, 1, 2, 3})); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for hooks.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	if hooks.Load() == 0 {
+		t.Fatal("PickRoute never fired the webhook, so this test cannot tell MatchingRule from it")
+	}
+}
