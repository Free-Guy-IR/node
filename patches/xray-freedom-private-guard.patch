+		geoip.Cidr = append(geoip.Cidr, &router.CIDR{Ip: prefix.Addr().AsSlice(), Prefix: uint32(prefix.Bits())})
+	}
+	return &PrivateTargetRule{Block: block, Ip: []*router.GeoIP{geoip}}
+}
