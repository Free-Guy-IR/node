+)
+
+func sendDatagramsThrough(ctx context.Context, handler outbound.Handler, inbound *session.Inbound, to net.Destination, timeoutOnly bool, count int) {
+	sendDatagramsOnAFlowTo(ctx, handler, inbound, to, to, timeoutOnly, count)
+}
+
+func sendDatagramsOnAFlowTo(ctx context.Context, handler outbound.Handler, inbound *session.Inbound, flow, to net.Destination, timeoutOnly bool, count int) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	ctx = session.ContextWithInbound(ctx, inbound)
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: flow, Tag: handler.Tag()}})
+	if timeoutOnly {
+		ctx = session.ContextWithTimeoutOnly(ctx, true)
+	}
+	uplinkReader, uplinkWriter := pipe.New()
+	downlinkReader, downlinkWriter := pipe.New()
+	for range count {
+		b := buf.New()
+		b.WriteString("datagram")
+		dest := to
+		b.UDP = &dest
+		uplinkWriter.WriteMultiBuffer(buf.MultiBuffer{b})
+	}
+	go func() {
+		time.Sleep(time.Second)
+		uplinkWriter.Close()
+	}()
+	go func() {
+		for {
+			if _, err := downlinkReader.ReadMultiBuffer(); err != nil {
+				return
+			}
+		}
+	}()
+	handler.Dispatch(ctx, &transport.Link{Reader: uplinkReader, Writer: downlinkWriter})
+}
+
+func datagramsReceived(conn gonet.PacketConn, within time.Duration) int {
+	packet := make([]byte, 64)
+	received := 0
+	for {
+		conn.SetReadDeadline(time.Now().Add(within))
+		if _, _, err := conn.ReadFrom(packet); err != nil {
+			return received
+		}
+		received++
+	}
+}
+
+func TestAnXUDPFlowKeepsThePrivateAllowOfItsDatagrams(t *testing.T) {
+	target, addr := listenUDPOnPrivateHost(t)
+	allowed := net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port))
+	ctx, handler, freedom := realFreedomOutboundWith(t, "DIRECT", &Config{PrivateAllow: []*PrivateTargetRule{allowEntry("lan", hostCIDR(addr.IP))}}, &proxyman.SenderConfig{})
+	freedom.router = routerOf(t, routingRule("lan", "DIRECT", nil, hostCIDR(addr.IP)))
+	for _, timeoutOnly := range []bool{false, true} {
+		sendDatagramsThrough(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, allowed, timeoutOnly, 3)
+		if received := datagramsReceived(target, 700*time.Millisecond); received != 3 {
+			t.Errorf("a UDP flow to %s, which rule lan sends to DIRECT and privateAllow lists, with TimeoutOnly %v (every XUDP flow of the mux server): %d of 3 datagrams delivered", allowed, timeoutOnly, received)
+		}
+	}
+}
+
+func TestAnXUDPFlowStillDropsDatagramsToARefusedPrivateAddress(t *testing.T) {
+	target, addr := listenUDPOnPrivateHost(t)
+	refused := net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port))
+	ctx, handler, _ := realFreedomOutboundWith(t, "DIRECT", &Config{}, &proxyman.SenderConfig{})
+	for _, timeoutOnly := range []bool{false, true} {
+		sendDatagramsThrough(ctx, handler, &session.Inbound{Name: "vless", Tag: "users"}, refused, timeoutOnly, 3)
+		if received := datagramsReceived(target, 700*time.Millisecond); received != 0 {
+			t.Errorf("a UDP flow to the refused private address %s with TimeoutOnly %v delivered %d datagrams", refused, timeoutOnly, received)
+		}
+	}
+}
+
+func tcpOnly(rule *PrivateTargetRule) *PrivateTargetRule {
+	rule.Networks = []net.Network{net.Network_TCP}
+	return rule
+}
+
+func TestAUDPOverTCPDatagramIsJudgedAsUDPByFinalRules(t *testing.T) {
+	serveScriptedDNS(t, &scriptedDNS{decide: nowhere})
+	target, addr := listenUDPOnPrivateHost(t)
+	ctx, handler := realFreedomOutbound(t, "DIRECT", &Config{FinalRules: []*PrivateTargetRule{tcpOnly(cidrRule(false, hostCIDR(addr.IP)))}})
+	users := &session.Inbound{Name: "vless", Tag: "users"}
+	dispatchThrough(ctx, handler, users, net.UDPDestination(net.IPAddress(addr.IP), net.Port(addr.Port)), []byte("datagram"))
+	if receivedDatagram(target, 700*time.Millisecond) {
+		t.Fatalf("plain UDP to %s was delivered although the only finalRules allow is for tcp", addr)
+	}
+	dispatchThrough(ctx, handler, users, net.TCPDestination(net.DomainAddress(uot.MagicAddress), 0), uotConnectFrame(t, addr, []byte("datagram")))
+	if receivedDatagram(target, time.Second) {
+		t.Errorf("a UDP-over-TCP datagram reached %s through a finalRules allow for tcp only, which plain UDP to the same address does not pass", addr)
+	}
+}
+
+func TestAUDPOverTCPDatagramIsJudgedAsUDPByTheRoutersFirstMatch(t *testing.T) {
