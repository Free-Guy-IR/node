+package shadowsocks_2022
+
+import (
+	"math/rand"
+	"testing"
+)
+
+func TestParsedDestinationIsNeverAnEmptyAddress(t *testing.T) {
+	inputs := [][]byte{
+		{3, 12, 'n', 'o', 't', ' ', 'a', ' ', 'd', 'o', 'm', 'a', 'i', 'n', 1, 187},
+		{3, 0, 1, 187},
+		{3},
+		{1, 10, 0, 0},
+		{4},
+		{0, 1, 2, 3},
+		{},
+	}
+	r := rand.New(rand.NewSource(1))
+	for range 20000 {
+		b := make([]byte, r.Intn(40))
+		r.Read(b)
+		if len(b) > 0 {
+			b[0] = []byte{1, 3, 4, 0, 2, 5}[r.Intn(6)]
+		}
+		inputs = append(inputs, b)
+	}
+	for _, in := range inputs {
+		func() {
+			defer func() {
+				if p := recover(); p != nil {
+					t.Fatalf("parsing %v panicked: %v", in, p)
+				}
+			}()
+			dest, n, err := ParseAddressPort(in)
+			if err != nil {
+				return
+			}
+			if dest.Address == nil || !dest.IsValid() || n <= 0 || n > len(in) {
+				t.Fatalf("parsing %v returned an unusable destination %v (%d bytes) without an error", in, dest, n)
+			}
+			_ = dest.Address.Family()
+			_ = dest.NetAddr()
+		}()
+	}
+}
