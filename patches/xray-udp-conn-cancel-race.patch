+package inbound
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+type unusedDispatcher struct{}
+
+func (unusedDispatcher) Type() interface{} { return routing.DispatcherType() }
+func (unusedDispatcher) Start() error      { return nil }
+func (unusedDispatcher) Close() error      { return nil }
+
+func (unusedDispatcher) Dispatch(context.Context, net.Destination) (*transport.Link, error) {
+	return &transport.Link{}, nil
+}
+
+func (unusedDispatcher) DispatchLink(context.Context, net.Destination, *transport.Link) error {
+	return nil
+}
+
+type cancelAwaitingProxy struct {
+	returned chan struct{}
+}
+
+func (p *cancelAwaitingProxy) Network() []net.Network { return []net.Network{net.Network_UDP} }
+
+func (p *cancelAwaitingProxy) Process(ctx context.Context, _ net.Network, _ stat.Connection, _ routing.Dispatcher) error {
+	<-ctx.Done()
+	p.returned <- struct{}{}
+	return nil
+}
+
+func TestUDPConnCancelIsPublishedUnderTheWorkerLockBeforeCleanClosesIt(t *testing.T) {
+	source := net.UDPDestination(net.LocalHostIP, net.Port(40000))
+	for iteration := 0; iteration < 50; iteration++ {
+		workerCtx, stopWorker := context.WithCancel(context.WithValue(context.Background(), "cone", true))
+		flow := &cancelAwaitingProxy{returned: make(chan struct{}, 1)}
+		w := &udpWorker{
+			proxy:      flow,
+			address:    net.LocalHostIP,
+			tag:        "udp-cancel-race",
+			stream:     &internet.MemoryStreamConfig{},
+			dispatcher: unusedDispatcher{},
+			ctx:        workerCtx,
+		}
+		common.Must(w.Start())
+
+		packet := buf.New()
+		common.Must2(packet.WriteString("probe"))
+		w.callback(packet, source, net.Destination{})
+
+		w.Lock()
+		conn := w.activeConn[connID{src: source}]
+		atomic.StoreInt64(&conn.lastActivityTime, 0)
+		w.Unlock()
+
+		w.clean()
+
+		stopWorker()
+		select {
+		case <-flow.returned:
+		case <-time.After(2 * time.Second):
+			t.Fatalf("iteration %d: udp flow did not end after its worker context was cancelled", iteration)
+		}
+		w.Close()
+	}
+}
