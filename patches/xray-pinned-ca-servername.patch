index 0000000..207bc30
--- /dev/null
+++ b/transport/internet/tls/pinned_ca_servername_test.go
@@ -0,0 +1,125 @@
+package tls
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	gotls "crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+type pinnedCAChain struct {
+	caDER   []byte
+	leafDER []byte
+}
+
+func issuePinnedCAChain(t *testing.T, leafName string) pinnedCAChain {
+	t.Helper()
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caTemplate := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "pinned test CA"},
+		NotBefore:             time.Now().Add(-time.Hour),
+		NotAfter:              time.Now().Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign,
+	}
+	caDER, err := x509.CreateCertificate(rand.Reader, caTemplate, caTemplate, &caKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caCert, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leafKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leafTemplate := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject:      pkix.Name{CommonName: leafName},
+		DNSNames:     []string{leafName},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	leafDER, err := x509.CreateCertificate(rand.Reader, leafTemplate, caCert, &leafKey.PublicKey, caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pinnedCAChain{caDER: caDER, leafDER: leafDER}
+}
+
+func (c pinnedCAChain) carrier(t *testing.T, serverName string) *RandCarrier {
+	t.Helper()
+	caCert, err := x509.ParseCertificate(c.caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &RandCarrier{
+		Config:               &gotls.Config{ServerName: serverName},
+		PinnedPeerCertSha256: [][]byte{GenerateCertHash(caCert)},
+	}
+}
+
+func TestPinnedCAWithoutServerNameRefusesALeafIssuedForAnyName(t *testing.T) {
+	chain := issuePinnedCAChain(t, "attacker.example")
+	err := chain.carrier(t, "").verifyPeerCert([][]byte{chain.leafDER, chain.caDER}, nil)
+	if err == nil {
+		t.Fatal("a pinned CA with no server name accepted a certificate issued for attacker.example")
+	}
+}
+
+func TestPinnedCARefusesALeafIssuedForAnotherServerName(t *testing.T) {
+	chain := issuePinnedCAChain(t, "attacker.example")
+	err := chain.carrier(t, "victim.example").verifyPeerCert([][]byte{chain.leafDER, chain.caDER}, nil)
+	if err == nil {
+		t.Fatal("a pinned CA accepted a certificate for attacker.example when the server name is victim.example")
+	}
+}
+
+func TestPinnedCAAcceptsALeafIssuedForTheServerName(t *testing.T) {
+	chain := issuePinnedCAChain(t, "victim.example")
+	err := chain.carrier(t, "victim.example").verifyPeerCert([][]byte{chain.leafDER, chain.caDER}, nil)
+	if err != nil {
+		t.Fatalf("a pinned CA refused a certificate issued for its own server name: %v", err)
+	}
+}
+
+func TestPinnedLeafStillNeedsNoServerName(t *testing.T) {
+	chain := issuePinnedCAChain(t, "any.example")
+	leafCert, err := x509.ParseCertificate(chain.leafDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	carrier := &RandCarrier{
+		Config:               &gotls.Config{},
+		PinnedPeerCertSha256: [][]byte{GenerateCertHash(leafCert)},
+	}
+	if err := carrier.verifyPeerCert([][]byte{chain.leafDER, chain.caDER}, nil); err != nil {
+		t.Fatalf("a pinned leaf with no server name was refused: %v", err)
+	}
+}
+
+func TestDestinationGivesThePinnedCAAServerName(t *testing.T) {
+	chain := issuePinnedCAChain(t, "victim.example")
+	config := (&Config{}).GetTLSConfig(WithDestination(net.TCPDestination(net.DomainAddress("victim.example"), 443)))
+	if config.ServerName != "victim.example" {
+		t.Fatalf("server name from destination = %q, want victim.example", config.ServerName)
+	}
+	if err := chain.carrier(t, config.ServerName).verifyPeerCert([][]byte{chain.leafDER, chain.caDER}, nil); err != nil {
+		t.Fatalf("a pinned CA refused the destination's own certificate: %v", err)
+	}
+}
