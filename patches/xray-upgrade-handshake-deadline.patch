+package httpupgrade_test
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"github.com/xtls/xray-core/transport/internet"
+	. "github.com/xtls/xray-core/transport/internet/httpupgrade"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func listenForHandshakeTests(t *testing.T) net.Port {
+	t.Helper()
+	port := tcp.PickPort()
+	listener, err := ListenHTTPUpgrade(context.Background(), net.LocalHostIP, port, &internet.MemoryStreamConfig{
+		ProtocolName:     "httpupgrade",
+		ProtocolSettings: &Config{Path: "/up"},
+	}, func(conn stat.Connection) {
+		conn.Close()
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	return port
+}
+
+func dialRaw(t *testing.T, port net.Port) net.Conn {
+	t.Helper()
+	conn, err := net.Dial("tcp", net.TCPDestination(net.LocalHostIP, port).NetAddr())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	return conn
+}
+
+func TestAnIdleHalfSentUpgradeRequestIsClosedAfterTheHandshakeDeadline(t *testing.T) {
+	conn := dialRaw(t, listenForHandshakeTests(t))
+	if _, err := conn.Write([]byte("GET /up HTTP/1.1\r\nHost: 127.0.0.1\r\n")); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	conn.SetReadDeadline(start.Add(9 * time.Second))
+	var b [64]byte
+	_, err := conn.Read(b[:])
+	waited := time.Since(start)
+	if errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatalf("the server still holds the half-sent request open after %v", waited)
+	}
+	if err != io.EOF && !strings.Contains(err.Error(), "reset") {
+		t.Fatalf("read after %v: %v, want the server to close the connection", waited, err)
+	}
+	if waited < 3*time.Second || waited > 7*time.Second {
+		t.Fatalf("the server closed the connection after %v, want about 4s", waited)
+	}
+}
+
+func TestAnUpgradeRequestWithHeadersOverTheLimitIsRefused(t *testing.T) {
+	conn := dialRaw(t, listenForHandshakeTests(t))
+	request := "GET /up HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nX-Pad: " + strings.Repeat("a", 16384) + "\r\n\r\n"
+	if _, err := conn.Write([]byte(request)); err != nil {
+		t.Fatal(err)
+	}
+	conn.SetReadDeadline(time.Now().Add(9 * time.Second))
+	line, err := bufio.NewReader(conn).ReadString('\n')
+	if strings.HasPrefix(line, "HTTP/1.1 101") {
+		t.Fatalf("the server upgraded a request with %d header bytes: %q", len(request), line)
+	}
+	if errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatal("the server neither answered nor closed the connection")
+	}
+}
+
+func TestAnUpgradeRequestWithinTheLimitIsStillUpgraded(t *testing.T) {
+	conn := dialRaw(t, listenForHandshakeTests(t))
+	request := "GET /up HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nX-Pad: " + strings.Repeat("a", 8192) + "\r\n\r\n"
+	if _, err := conn.Write([]byte(request)); err != nil {
+		t.Fatal(err)
+	}
+	conn.SetReadDeadline(time.Now().Add(9 * time.Second))
+	line, err := bufio.NewReader(conn).ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(line, "HTTP/1.1 101") {
+		t.Fatalf("status line %q, want 101 Switching Protocols", line)
+	}
+}
