+// readShortQuicVarint wraps quicvarint.Read with a max limit for length related fields.
+// we only handle QUIC Initial so these numbers should not exceed 65535
+// returns int32 to reduce type conversion
+func readShortQuicVarint(reader io.ByteReader) (int32, error) {
+	v, err := quicvarint.Read(reader)
+	if err != nil {
+		return 0, err
+	}
+	if v > 65535 {
+		// not used(
+		return 0, errNotQuicInitial
+	}
+	return int32(v), nil
+}
diff --git a/common/protocol/quic/sniff_short_initial_test.go b/common/protocol/quic/sniff_short_initial_test.go
new file mode 100644
index 0000000..708c61f
--- /dev/null
+++ b/common/protocol/quic/sniff_short_initial_test.go
@@ -0,0 +1,16 @@
+package quic
+
+import "testing"
+
+func TestSniffQUICShortInitialNoPanic(t *testing.T) {
+	packet := []byte{0xC0, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00, 0x00}
+	b := packet[:len(packet):len(packet)]
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("SniffQUIC panicked on a 13-byte initial packet: %v", r)
+		}
+	}()
+	if _, err := SniffQUIC(b); err == nil {
+		t.Fatal("SniffQUIC accepted a truncated initial packet")
+	}
+}
