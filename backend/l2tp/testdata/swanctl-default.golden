connections {
    l2tp-de {
        version = 1
        proposals = aes256-sha256-modp2048,aes256-sha1-modp2048,aes256-sha1-modp1024,aes128-sha1-modp1024
        encap = yes
        fragmentation = yes
        dpd_delay = 30s
        local {
            auth = psk
        }
        remote {
            auth = psk
        }
        children {
            l2tp-de {
                esp_proposals = aes256-sha256,aes256-sha1,aes128-sha1,aes256-sha256-modp2048,aes256-sha1-modp2048,aes128-sha1-modp2048,aes256-sha1-modp1536,aes128-sha1-modp1536,aes256-sha1-modp1024,aes128-sha1-modp1024
                local_ts = dynamic[udp/1701]
                remote_ts = dynamic[udp]
                mode = transport
                dpd_action = clear
            }
        }
    }
}

secrets {
    ike-l2tp-de {
        secret = "correct-horse-battery"
    }
}
