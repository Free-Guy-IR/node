connections {
    l2tp-custom {
        version = 1
        proposals = aes256-sha256-modp2048,aes128-sha1-modp1024
        encap = yes
        fragmentation = yes
        dpd_delay = 30s
        local {
            auth = psk
        }
        remote {
            auth = psk
        }
        children {
            l2tp-custom {
                esp_proposals = aes256-sha256
                local_ts = dynamic[udp/1701]
                remote_ts = dynamic[udp]
                mode = transport
                dpd_action = clear
            }
        }
    }
}

secrets {
    ike-l2tp-custom {
        secret = "correct-horse-battery"
    }
}
