new file mode 100644
index 0000000..efbeed8
--- /dev/null
+++ b/transport/internet/connect_check.go
@@ -0,0 +1,21 @@
+package internet
+
+import "context"
+
+type connectCheckKey struct{}
+
+type ConnectCheck func(network, address string) error
+
+func ContextWithConnectCheck(ctx context.Context, check ConnectCheck) context.Context {
+	return context.WithValue(ctx, connectCheckKey{}, check)
+}
+
+func connectCheckFromContext(ctx context.Context) ConnectCheck {
+	check, _ := ctx.Value(connectCheckKey{}).(ConnectCheck)
+	return check
+}
+
+func SystemDialerChecksConnects() bool {
+	_, ok := effectiveSystemDialer.(*DefaultSystemDialer)
+	return ok
+}
