+
+var errConnectRefused = errors.New("refused at connect")
+
+type connectRefusal struct {
+	mu     sync.Mutex
+	target *net.Destination
+	kind   string
+}
+
+func (c *connectRefusal) refuse(target net.Destination, kind string) error {
+	c.mu.Lock()
+	if c.target == nil {
+		c.target, c.kind = &target, kind
+	}
+	c.mu.Unlock()
+	return errConnectRefused
+}
+
+func (c *connectRefusal) result() (*net.Destination, string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.target, c.kind
+}
+
+func (c *connectRefusal) check(decide func(net.Destination) string, network net.Network) internet.ConnectCheck {
+	return func(_, address string) error {
+		parsed, err := netip.ParseAddrPort(address)
+		if err != nil {
+			return c.refuse(net.Destination{Network: network, Address: net.DomainAddress(address)}, "unparseable")
+		}
+		ip := parsed.Addr().WithZone("").Unmap()
+		target := net.Destination{Network: network, Address: net.IPAddress(ip.AsSlice()), Port: net.Port(parsed.Port())}
+		if kind := decide(target); kind != "" {
+			return c.refuse(target, kind)
+		}
+		return nil
+	}
+}
+
+func (h *Handler) checkedResolvedTarget(ctx context.Context, inbound *session.Inbound, dest net.Destination) (*net.Destination, string, error) {
+	addrs, err := net.DefaultResolver.LookupIPAddr(ctx, dest.Address.Domain())
+	if err != nil {
+		errors.LogInfoInner(ctx, err, "failed to resolve ", dest.Address.Domain(), " before dialing it")
+		return nil, "", err
+	}
+	for _, addr := range addrs {
+		resolved := net.Destination{Network: dest.Network, Address: net.IPAddress(addr.IP), Port: dest.Port}
+		if isLocalHostAddress(resolved.Address) {
+			return &resolved, "local host", nil
+		}
+		if h.refusesPrivateTarget(ctx, inbound, resolved) {
+			return &resolved, "private", nil
+		}
+	}
+	return nil, "", nil
+}
